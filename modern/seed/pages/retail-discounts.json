{
  "schemaVersion": 1,
  "id": "retail-discounts",
  "name": "Retail Discounts",
  "kind": "custom",
  "canvas": {
    "w": 1920,
    "h": 1080
  },
  "grid": 8,
  "zones": [
    {
      "id": "rds-sale",
      "kind": "orderList",
      "shape": "rect",
      "behavior": "none",
      "rect": {
        "x": 16,
        "y": 16,
        "w": 640,
        "h": 1048
      }
    },
    {
      "id": "rds-title",
      "kind": "label",
      "rect": {
        "x": 680,
        "y": 16,
        "w": 1224,
        "h": 80
      },
      "shape": "rect",
      "behavior": "none",
      "label": "Discount: which?"
    },
    {
      "id": "rds-item",
      "kind": "button",
      "label": "ITEM DISCOUNT\n\nthe last item rung\n(or the one touched)",
      "shape": "pill",
      "behavior": "blink",
      "rect": {
        "x": 680,
        "y": 112,
        "w": 600,
        "h": 560
      },
      "style": {
        "normal": {
          "fill": "#f59e0b",
          "text": "#111827"
        }
      },
      "actions": [
        {
          "type": "jump",
          "mode": "replace",
          "page": "retail-discount-item"
        }
      ]
    },
    {
      "id": "rds-subtotal",
      "kind": "button",
      "label": "SUBTOTAL DISCOUNT\n\neverything in the sale",
      "shape": "pill",
      "behavior": "blink",
      "rect": {
        "x": 1304,
        "y": 112,
        "w": 600,
        "h": 560
      },
      "style": {
        "normal": {
          "fill": "#38bdf8",
          "text": "#111827"
        }
      },
      "actions": [
        {
          "type": "jump",
          "mode": "replace",
          "page": "retail-discount-sale"
        }
      ]
    },
    {
      "id": "rds-note",
      "kind": "label",
      "rect": {
        "x": 680,
        "y": 696,
        "w": 1224,
        "h": 120
