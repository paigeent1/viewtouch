      "shape": "rect",
      "behavior": "none",
      "label": "Items marked No discounts (cigarettes) are never discounted."
    },
    {
      "id": "rds-back",
      "kind": "button",
      "label": "‹ Back to the sale",
      "shape": "pill",
      "behavior": "blink",
      "rect": {
        "x": 680,
        "y": 976,
        "w": 1224,
        "h": 88
      },
      "style": {
        "normal": {
          "fill": "#475569",
          "text": "#ffffff"
        }
      },
      "actions": [
        {
          "type": "jump",
          "mode": "back"
        }
      ]
