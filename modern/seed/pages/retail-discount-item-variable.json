      "shape": "rect",
      "behavior": "none",
      "label": "Type the percent off (15 for 15%), then Apply"
    },
    {
      "id": "rd-item-variable-pad",
      "kind": "numPad",
      "shape": "rect",
      "behavior": "none",
      "rect": {
        "x": 680,
        "y": 112,
        "w": 760,
        "h": 840
      }
    },
    {
