#!/bin/bash
# Makes a video ready for the guest screen (Store Settings > Customer display > + Add a picture or
# video runs it): an H.264 MP4 at most 1920x1080, AAC sound, that the Pi plays smoothly. A phone's
# HEVC video is converted; an upright (portrait) video fills the wide screen with a soft, darkened,
# blurred copy of itself on the sides instead of black bars. An MP4 that's already right is only
# re-packed (seconds). The Dropbox original is never touched.
#   vt-guest-video-prep IN.mov OUT.mp4
IN="$1"; OUT="$2"
[ -f "$IN" ] && [ -n "$OUT" ] || { echo "usage: vt-guest-video-prep IN OUT.mp4"; exit 2; }
command -v ffmpeg >/dev/null && command -v ffprobe >/dev/null || { echo "ffmpeg isn't installed (vt-server installs it)"; exit 3; }
# Size as shown (the phone's rotation applied: ffmpeg turns it upright when converting).
read -r W H ROT CODEC <<<"$(ffprobe -v error -select_streams v:0 \
    -show_entries stream=width,height,codec_name:stream_side_data=rotation:stream_tags=rotate \
    -of default=nw=1 "$IN" | awk -F= '/^width=/{w=$2} /^height=/{h=$2} /^codec_name=/{c=$2} /rotat/{r=$2} END{print w+0, h+0, (r==""?0:r), c}')"
[ "$W" -gt 0 ] && [ "$H" -gt 0 ] || { echo "Not a video ffmpeg can read: $IN"; exit 4; }
case "${ROT#-}" in 90|270) t=$W; W=$H; H=$t ;; esac
PART="$OUT.part.mp4"
rm -f "$PART"
if [ "$CODEC" = h264 ] && [ "$W" -gt "$H" ] && [ "$W" -le 1920 ] && [ "$H" -le 1080 ]; then
    # Already fine: re-packed for quick starts, sound made AAC if it isn't.
    ffmpeg -v error -y -i "$IN" -map 0:v:0 -map '0:a:0?' -c:v copy -c:a aac -b:a 160k -movflags +faststart "$PART"
elif [ "$H" -ge "$W" ]; then
    # Upright: the video in the middle at full height, a blurred copy of it filling the sides.
    ffmpeg -v error -y -i "$IN" -filter_complex \
        "[0:v]scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,boxblur=30:5,eq=brightness=-0.08[bg];[0:v]scale=-2:1080[fg];[bg][fg]overlay=(W-w)/2:0,format=yuv420p[v]" \
        -map '[v]' -map '0:a:0?' -c:v libx264 -preset veryfast -crf 22 -c:a aac -b:a 160k -movflags +faststart "$PART"
else
    # Wide: fit to 1920x1080 at most, H.264.
    ffmpeg -v error -y -i "$IN" -map 0:v:0 -map '0:a:0?' \
        -vf "scale='min(1920,iw)':'min(1080,ih)':force_original_aspect_ratio=decrease,scale=trunc(iw/2)*2:trunc(ih/2)*2,format=yuv420p" \
        -c:v libx264 -preset veryfast -crf 22 -c:a aac -b:a 160k -movflags +faststart "$PART"
fi
status=$?
if [ $status -ne 0 ] || [ ! -s "$PART" ]; then rm -f "$PART"; echo "Couldn't prepare $(basename "$IN")"; exit 5; fi
mv -f "$PART" "$OUT" && echo "Ready: $(basename "$OUT")"
