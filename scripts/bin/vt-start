#!/bin/bash
# Starts ViewTouch the way vt-server does (the store server, the customer display on the second
# monitor when it's on, this site's scanner) but WITHOUT rebuilding: it runs the build already
# there. For the desktop shortcut and after a reboot. vt-server = rebuild from the code + restart.
# The build for this site's Qt (vt-site QT_PREFIX): modern/build (Debian's Qt) or modern/build-qt612.
. "$(dirname "$(readlink -f "$0")")/vt-site-lib"
BIN="$VT_BUILD/vtmodern"
[ -x "$BIN" ] || BIN=/usr/local/bin/vtmodern
if pgrep -x vtmodern >/dev/null; then
    pkill -TERM -x vtmodern 2>/dev/null || true
    for _ in $(seq 1 20); do pgrep -x vtmodern >/dev/null || break; sleep 0.5; done
    pkill -KILL -x vtmodern 2>/dev/null || true
fi
GUEST="${VT_CUSTOMER_DISPLAY:-$(cat "$HOME/.vt-customer-display" 2>/dev/null)}"
EXTRA=()
[ -n "$GUEST" ] && [ "$GUEST" != off ] && EXTRA=(--customer-display "$GUEST")
[ -n "$SERIAL_SCANNER" ] && export VT_SERIAL_SCANNER="$SERIAL_SCANNER"
export VT_SERIAL_SCANNER_BAUD="$SERIAL_SCANNER_BAUD"
# May this computer become another one's standby (vt-site STANDBY_ALLOWED)? Not set: yes, as before.
export VT_STANDBY_ALLOWED="${STANDBY_ALLOWED:-yes}"
# The monitors side by side again (vt-guest-display saved how), in case the desktop came up mirrored.
[ -n "$GUEST" ] && [ "$GUEST" != off ] && [ -x "$HOME/.config/vt-guest-display.sh" ] && "$HOME/.config/vt-guest-display.sh" >/dev/null 2>&1
# Its messages go to ~/.vt-run.log (the run before in ~/.vt-run.log.1): what it said if it stops.
[ -f "$HOME/.vt-run.log" ] && mv -f "$HOME/.vt-run.log" "$HOME/.vt-run.log.1"
WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/$(id -u) DISPLAY=:0 "$BIN" --serve "${EXTRA[@]}" >"$HOME/.vt-run.log" 2>&1 &
pid=$!
# Still running a few seconds later (it looks for another server of this store first)?
sleep 4
if grep -q "set not to become its standby" "$HOME/.vt-run.log" 2>/dev/null; then
    echo "ViewTouch didn't start: $(grep -m1 "set not to become its standby" "$HOME/.vt-run.log")"
    echo "(To let this computer be that one's standby: vt-site set STANDBY_ALLOWED yes, then vt-start.)"
    exit 1
fi
if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" 2>/dev/null
    echo "ViewTouch didn't start: it stopped right away (exit status $?). Its last messages (~/.vt-run.log):"
    grep -v '^[[:space:]]*$' "$HOME/.vt-run.log" 2>/dev/null | tail -n 4 | sed 's/^/  /'
    exit 1
fi
echo "ViewTouch started (no rebuild).${GUEST:+ Customer display: $GUEST.}"
