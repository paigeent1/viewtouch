#!/bin/bash
set -e
. "$(dirname "$(readlink -f "$0")")/vt-site-lib"
cd "$VT_REPO"
# Video on the customer display needs Qt Multimedia: installed once, the first time it's missing.
if command -v dpkg >/dev/null && ! dpkg -s qt6-multimedia-dev >/dev/null 2>&1; then
    echo "Installing Qt Multimedia (video on the customer display)..."
    sudo apt-get install -y qt6-multimedia-dev qml6-module-qtmultimedia >/dev/null \
        && { sudo apt-get install -y qt6-ffmpeg-multimedia-plugin >/dev/null 2>&1 \
             || sudo apt-get install -y qt6-gstreamer-multimedia-plugin >/dev/null 2>&1 || true; } \
        && touch modern/CMakeLists.txt \
        || echo "Couldn't install Qt Multimedia; ViewTouch builds without video (pictures and GIFs still work)."
fi
# Qt Multimedia's build files also need Qt's private GUI files, and playing a video needs a backend
# (FFmpeg): without them the build says "Qt Multimedia not found" even with qt6-multimedia-dev in
# (2026-11-06 on the HCA Pi). Installed once when missing; the build then looks again.
if command -v dpkg >/dev/null && dpkg -s qt6-multimedia-dev >/dev/null 2>&1; then
    need=()
    dpkg -s qt6-base-private-dev >/dev/null 2>&1 || need+=(qt6-base-private-dev)
    # A playback backend: Debian's Qt Multimedia brings its own (2026-11-07 the HCA Pi played video
    # with no extra package; qt6-ffmpeg-multimedia-plugin doesn't exist there), so only when none is.
    ls /usr/lib/*/qt6/plugins/multimedia/*.so >/dev/null 2>&1 || need+=(qt6-ffmpeg-multimedia-plugin)
    if [ ${#need[@]} -gt 0 ]; then
        echo "Installing ${need[*]} (video on the customer display)..."
        # --fresh: the build folder remembers "Qt Multimedia not found" from before the install
        # (2026-11-06 on the HCA Pi: a fresh project found it, the old build folder didn't).
        sudo apt-get install -y "${need[@]}" >/dev/null 2>&1 \
            && cmake --fresh -S modern -B modern/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER_LAUNCHER=ccache >/dev/null \
            || echo "Couldn't install ${need[*]}; video on the customer display may not play (pictures and GIFs still work)."
    fi
fi
# Guest-screen videos are made ready with ffmpeg (vt-guest-video-prep): installed once when missing.
if command -v dpkg >/dev/null && ! command -v ffmpeg >/dev/null; then
    echo "Installing ffmpeg (guest-screen videos)..."
    sudo apt-get install -y ffmpeg >/dev/null 2>&1 || echo "Couldn't install ffmpeg; guest-screen videos are copied as they are."
fi
# The top bar's icons (battery, Wi-Fi, customer count) are emoji: installed once when the font is missing.
if command -v dpkg >/dev/null && ! dpkg -s fonts-noto-color-emoji >/dev/null 2>&1; then
    echo "Installing the emoji font (the top bar's icons)..."
    sudo apt-get install -y fonts-noto-color-emoji >/dev/null 2>&1 && fc-cache -f >/dev/null 2>&1 \
        || echo "Couldn't install the emoji font; the top bar shows boxes for its icons."
fi
# Qt Multimedia installed but this build folder still says it isn't there: look again, once.
if grep -q "Qt6Multimedia_DIR:PATH=.*NOTFOUND" modern/build/CMakeCache.txt 2>/dev/null \
        && [ -f /usr/lib/aarch64-linux-gnu/cmake/Qt6Multimedia/Qt6MultimediaConfig.cmake -o -f /usr/lib/x86_64-linux-gnu/cmake/Qt6Multimedia/Qt6MultimediaConfig.cmake ]; then
    echo "Looking for Qt Multimedia again (video on the customer display)..."
    cmake --fresh -S modern -B modern/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER_LAUNCHER=ccache >/dev/null \
        || echo "Couldn't look for Qt Multimedia again; building with the settings already there."
fi
if ! cmake --build modern/build --target vtmodern -j${VT_JOBS:-4}; then
    echo "ViewTouch didn't start: the build failed (see above). The ViewTouch already running was left as it was."
    exit 1
fi
# From here on no step ends the script half-way. set -e did, 2026-11-08 on the new HCA Pi: with no
# ~/.vt-customer-display, GUEST="${VT_CUSTOMER_DISPLAY:-$(cat ...)}" failed and ended the script
# right after the build, without a word and before ViewTouch was started (vt-start, without set -e,
# worked). Each step now says what went wrong and carries on.
set +e
# A vt-* command added since this Pi linked them (e.g. vt-screens): linked now, so it runs by name.
for f in "$VT_REPO"/scripts/bin/vt-*; do
    [ -e "/usr/local/bin/$(basename "$f")" ] && continue
    sudo ln -sf "$f" /usr/local/bin/ 2>/dev/null || echo "Note: couldn't link $(basename "$f") into /usr/local/bin (run it as $f)."
done
sudo cp -f modern/build/vtmodern /usr/local/bin/vtmodern 2>/dev/null \
    || echo "Note: couldn't copy the new vtmodern to /usr/local/bin (this script runs the one in modern/build)."
# Stop ViewTouch the polite way first (it saves and closes the database on
# SIGTERM); force it only if it is still running after 10 seconds.
if pgrep -x vtmodern >/dev/null; then
    pkill -TERM -x vtmodern 2>/dev/null
    for _ in $(seq 1 20); do pgrep -x vtmodern >/dev/null || break; sleep 0.5; done
    if pgrep -x vtmodern >/dev/null; then
        echo "ViewTouch didn't stop in 10 seconds; stopping it now."
        pkill -KILL -x vtmodern 2>/dev/null
        sleep 1
    fi
fi
# The customer display on the second monitor (vt-guest-display on|off writes ~/.vt-customer-display;
# no file: none).
GUEST="${VT_CUSTOMER_DISPLAY:-}"
if [ -z "$GUEST" ] && [ -f "$HOME/.vt-customer-display" ]; then GUEST=$(cat "$HOME/.vt-customer-display" 2>/dev/null); fi
EXTRA=()
if [ -n "$GUEST" ] && [ "$GUEST" != off ]; then EXTRA=(--customer-display "$GUEST"); fi
# This site's scanner port and speed (vt-site), when set.
if [ -n "${SERIAL_SCANNER:-}" ]; then export VT_SERIAL_SCANNER="$SERIAL_SCANNER"; fi
export VT_SERIAL_SCANNER_BAUD="${SERIAL_SCANNER_BAUD:-9600}"
# May this computer become another one's standby (vt-site STANDBY_ALLOWED)? Not set: yes, as before.
export VT_STANDBY_ALLOWED="${STANDBY_ALLOWED:-yes}"
# Its messages go to ~/.vt-run.log (the run before in ~/.vt-run.log.1): what it said if it stops.
if [ -f "$HOME/.vt-run.log" ]; then mv -f "$HOME/.vt-run.log" "$HOME/.vt-run.log.1" || echo "Note: couldn't keep the last run's log."; fi
BIN="$VT_REPO/modern/build/vtmodern"
if [ ! -x "$BIN" ]; then
    echo "ViewTouch didn't start: $BIN is missing after the build."
    exit 1
fi
WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/$(id -u) DISPLAY=:0 "$BIN" --serve "${EXTRA[@]}" >"$HOME/.vt-run.log" 2>&1 &
pid=$!
# Still running a few seconds later (it looks for another server of this store first)?
sleep 4
if grep -q "set not to become its standby" "$HOME/.vt-run.log" 2>/dev/null; then
    echo "ViewTouch didn't start: $(grep -m1 "set not to become its standby" "$HOME/.vt-run.log")"
    echo "(To let this computer be that one's standby: vt-site set STANDBY_ALLOWED yes, then vt-server.)"
    exit 1
fi
if ! kill -0 "$pid" 2>/dev/null; then
    wait "$pid" 2>/dev/null
    code=$?
    case "$code" in
        68) reason="another computer is already running this store, and this one is set not to become its standby (to allow it: vt-site set STANDBY_ALLOWED yes)" ;;
        *) reason="it stopped right away (exit status $code)" ;;
    esac
    echo "ViewTouch didn't start: $reason."
    why=$(grep -v '^[[:space:]]*$' "$HOME/.vt-run.log" 2>/dev/null | tail -n 4)
    if [ -n "$why" ]; then echo "Its last messages (~/.vt-run.log):"; echo "$why" | sed 's/^/  /'; fi
    exit 1
fi
echo "Server rebuilt and restarted.${GUEST:+ Customer display: $GUEST.}"
