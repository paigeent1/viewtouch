#!/bin/bash
set -e
cd /home/pi/viewtouch-main
cmake --build modern/build --target vtmodern -j${VT_JOBS:-4}
sudo cp -f modern/build/vtmodern /usr/local/bin/vtmodern 2>/dev/null || true
killall -9 vtmodern 2>/dev/null || true
sleep 1
# The customer display on the second monitor (vt-guest-display on|off writes ~/.vt-customer-display).
GUEST="${VT_CUSTOMER_DISPLAY:-$(cat "$HOME/.vt-customer-display" 2>/dev/null)}"
EXTRA=()
[ -n "$GUEST" ] && [ "$GUEST" != off ] && EXTRA=(--customer-display "$GUEST")
WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/$(id -u) DISPLAY=:0 /home/pi/viewtouch-main/modern/build/vtmodern --serve "${EXTRA[@]}" >/dev/null 2>&1 &
echo "Server rebuilt and restarted.${GUEST:+ Customer display: $GUEST.}"
