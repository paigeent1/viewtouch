#!/usr/bin/env python3
"""ILSA self-check round 3 (dry run): which formula on the receipts' tender rows gives ILSA's daily Z
tender totals. Round 2 showed Z = AMT_TEND for checks, gift cards and cards (SALE_AMT is the whole
sale on each row); this tries formulas for cash, day by day. Counts and dollars only.
  vt-ilsa-tieout3 ~/ilsa-export/"copy bhdan 10-29-2026"
"""
import csv, os, sys
from collections import defaultdict

csv.field_size_limit(1 << 30)
D = sys.argv[1] if len(sys.argv) > 1 else ""
if not os.path.isdir(D):
    sys.exit("Usage: vt-ilsa-tieout3 ~/ilsa-export/<database name>")

def rows(t):
    for f in os.listdir(D):
        if f.lower() == (t + ".csv").lower():
            with open(os.path.join(D, f), newline="", errors="replace") as fh:
                yield from csv.DictReader(fh)
            return

def num(s):
    try: return float(s)
    except (TypeError, ValueError): return 0.0

z = defaultdict(lambda: defaultdict(float))
for r in rows("Z_Tender"):
    z[(r.get("REG_NUM"), r.get("REG_Z_COUNTER"))][r.get("TENDER_TYPE")] += num(r.get("TENDER_AMT"))

F = {
    "AMT_TEND": lambda a, t, c: t,
    "AMT_TEND - CHANGE_DUE": lambda a, t, c: t - c,
    "AMT_TEND - CHANGE_DUE, sales only (SALE_AMT >= 0)": lambda a, t, c: (t - c) if a >= 0 else 0.0,
    "AMT_TEND - CHANGE_DUE, refunds as SALE_AMT": lambda a, t, c: (t - c) if a >= 0 else a,
    "AMT_TEND, refunds as SALE_AMT": lambda a, t, c: t if a >= 0 else a,
    "min(AMT_TEND, SALE_AMT) (sales), SALE_AMT (refunds)": lambda a, t, c: min(t, a) if a >= 0 else a,
}
got = defaultdict(lambda: defaultdict(lambda: defaultdict(float)))   # formula -> z -> type -> $
neg = defaultdict(lambda: defaultdict(float))
for r in rows("TENDSALE"):
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER")); ty = r.get("TENDER_TYPE")
    a, t, c = num(r.get("SALE_AMT")), num(r.get("AMT_TEND")), num(r.get("CHANGE_DUE"))
    for name, f in F.items():
        got[name][k][ty] += f(a, t, c)
    if a < 0:
        neg[ty]["rows"] += 1; neg[ty]["SALE_AMT"] += a; neg[ty]["AMT_TEND"] += t; neg[ty]["CHANGE_DUE"] += c

print("== Days matching ILSA's Z to the cent, per tender type, per formula")
for name in F:
    parts = []
    for ty in ("1", "10", "15", "70"):
        ok = n = 0; diff = 0.0
        for k, zt in z.items():
            if ty not in zt and ty not in got[name].get(k, {}): continue
            n += 1; d = got[name][k].get(ty, 0.0) - zt.get(ty, 0.0); diff += d
            ok += abs(d) < 0.015
        parts.append(f"type {ty}: {ok}/{n} days, total diff {diff:+,.2f}")
    print(f"  {name}\n     " + "\n     ".join(parts))
print("\n== Negative tender rows (refunds / paid outs): columns")
for ty, cols in sorted(neg.items()):
    print(f"  type {ty}: " + ", ".join(f"{c} {v:,.2f}" for c, v in cols.items()))
print("\nDone. Paste everything above to Bob.")
