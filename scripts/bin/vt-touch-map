#!/bin/bash
# Reads the monitors with xrandr --current (plain xrandr re-probes them: some monitors blank for a moment).
# Ties each touchscreen to its own monitor (X11): the guest's touchscreen (learned once with
# `vt-guest-display touch`, remembered by the USB port it's plugged into) to the second monitor,
# every other touchscreen to the first (the POS). Run by vt-guest-display and after every reboot.
#   vt-touch-map          tie them now (--verbose: and say where each one went)
#   vt-touch-map --watch  and again whenever a touchscreen (re)connects or the monitors change: X
#                         forgets the tie when a device reconnects (a reboot, a USB hiccup)
export DISPLAY="${DISPLAY:-:0}"
[ "$1" = --verbose ] && export VT_TOUCH_VERBOSE=1   # say where each one went (Screen check)
if [ "$1" = --watch ]; then
    for p in $(pgrep -f "vt-touch-map --watc[h]"); do [ "$p" != "$$" ] && kill "$p" 2>/dev/null; done   # one watcher
    last=""
    while sleep 3; do
        ids=$(xinput list 2>/dev/null | grep -i -E 'touch|ctp|ilitek|goodix|egalax|eeti' | grep -o 'id=[0-9]*' | cut -d= -f2)
        # Each one's tie (its transformation matrix) too: a touchscreen that reconnects under the
        # same id comes back untied (the whole screen), and the ids alone wouldn't show that.
        ties=$(for i in $ids; do xinput list-props "$i" 2>/dev/null | grep -m1 'Coordinate Transformation Matrix'; done)
        now="$ids $ties $(xrandr --current 2>/dev/null | grep ' connected')"
        if [ "$now" != "$last" ]; then
            sleep 1
            "$0"
            # Read again after tying, so the tie it just made isn't taken for a change.
            ids=$(xinput list 2>/dev/null | grep -i -E 'touch|ctp|ilitek|goodix|egalax|eeti' | grep -o 'id=[0-9]*' | cut -d= -f2)
            ties=$(for i in $ids; do xinput list-props "$i" 2>/dev/null | grep -m1 'Coordinate Transformation Matrix'; done)
            last="$ids $ties $(xrandr --current 2>/dev/null | grep ' connected')"
        fi
    done
fi
outs=$(xrandr --current 2>/dev/null | awk '/ connected/{print $1}')
first=$(echo "$outs" | sed -n 1p); second=$(echo "$outs" | sed -n 2p)
# The register's monitor, when the store said which (vt-guest-display on HDMI-2): first, whatever the order.
pos=$(cat "$HOME/.vt-pos-output" 2>/dev/null)
if [ -n "$pos" ] && echo "$outs" | grep -qx "$pos"; then first="$pos"; second=$(echo "$outs" | grep -vx "$pos" | sed -n 1p); fi
[ -z "$first" ] && exit 0
# The port only (a hub port is "usb-0:1.2"; the interface part, ":1.0", isn't kept).
guest_port=$(sed 's/\(usb-[0-9]*:[0-9.]*\):[0-9]*\.[0-9]*$/\1/' "$HOME/.vt-guest-touch" 2>/dev/null)
port_of() {   # the USB port (udev ID_PATH) behind an xinput device id
    local node
    node=$(xinput list-props "$1" 2>/dev/null | awk -F'"' '/Device Node/{print $2; exit}')
    # The port only: a touchscreen is two devices on interfaces :1.0 and :1.1 of the same port.
    [ -n "$node" ] && udevadm info -q property -n "$node" 2>/dev/null | sed -n 's/^ID_PATH=//p' | sed 's/\(usb-[0-9]*:[0-9.]*\):[0-9]*\.[0-9]*$/\1/'
}
for id in $(xinput list | grep -i -E 'touch|ctp|ilitek|goodix|egalax|eeti' | grep -i pointer | grep -o 'id=[0-9]*' | cut -d= -f2); do
    target=$first
    if [ -n "$second" ] && [ -n "$guest_port" ] && [ "$(port_of "$id")" = "$guest_port" ]; then
        target=$second
    fi
    xinput map-to-output "$id" "$target" 2>/dev/null || true
    [ -n "$VT_TOUCH_VERBOSE" ] && echo "touch device $id (port $(port_of "$id")) -> $target"
done
exit 0
