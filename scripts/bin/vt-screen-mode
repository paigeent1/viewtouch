#!/bin/bash
# A monitor's size and refresh rate (X11), kept after reboots. Screen check's "Best mode" and
# "Change..." buttons run this.
#   vt-screen-mode HDMI-1 best                its own preferred size and rate (xrandr --auto)
#   vt-screen-mode HDMI-1 1920x1080 60        that size at 60 Hz
#   vt-screen-mode HDMI-1 1920x1080           that size, the rate xrandr picks
# Kept in ~/.vt-screen-modes (HDMI-1=1920x1080@60); vt-guest-display uses it when it sets the
# monitors up (and at every boot). ViewTouch isn't restarted: its windows refit to the new size.
export DISPLAY="${DISPLAY:-:0}"
OUT="$1"; SIZE="$2"; RATE="$3"
[ -z "$OUT" ] || [ -z "$SIZE" ] && { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
[[ "$OUT" =~ ^[A-Za-z0-9-]{1,24}$ ]] || { echo "Not a monitor name: $OUT"; exit 1; }
xrandr | grep -q "^$OUT connected" || { echo "No monitor plugged in at $OUT."; exit 1; }
if [ "$SIZE" = best ]; then
    value=best; args=(--auto)
else
    [[ "$SIZE" =~ ^[0-9]{3,4}x[0-9]{3,4}$ ]] || { echo "Not a size: $SIZE (like 1920x1080)"; exit 1; }
    [ -z "$RATE" ] || [[ "$RATE" =~ ^[0-9]{2,3}(\.[0-9]{1,2})?$ ]] || { echo "Not a rate: $RATE (like 60)"; exit 1; }
    # Only a size this monitor offers.
    xrandr | awk -v o="$OUT" '$1==o{f=1;next} /^[A-Za-z]/{f=0} f{print $1}' | grep -qx "$SIZE" \
        || { echo "$OUT doesn't offer $SIZE."; exit 1; }
    value="$SIZE${RATE:+@$RATE}"; args=(--mode "$SIZE"); [ -n "$RATE" ] && args+=(--rate "$RATE")
fi
F="$HOME/.vt-screen-modes"
touch "$F"; sed -i "/^$OUT=/d" "$F"; echo "$OUT=$value" >> "$F"
xrandr --output "$OUT" "${args[@]}" || { echo "Couldn't set $OUT to $value."; exit 1; }
# Monitors side by side again (sizes changed), and the boot script rewritten with the new size.
if [ "$(cat "$HOME/.vt-customer-display" 2>/dev/null)" = window ]; then
    sleep 1
    vt-guest-display layout >/dev/null 2>&1 || true
fi
now=$(xrandr | awk -v o="$OUT" '$1==o{f=1;next} /^[A-Za-z]/{f=0} f && /\*/{for(i=2;i<=NF;i++) if($i ~ /\*/){r=$i; gsub(/[*+]/,"",r); print $1" at "r" Hz"; exit}}')
echo "$OUT is now ${now:-set} (kept after reboots)."
