#!/bin/bash
# Are this site's tablets on the server's build? (tablets: vt-site)
. "$(dirname "$(readlink -f "$0")")/vt-site-lib"
LATEST=$(cat "$VT_REPO/modern/build/generated/vtm_build_number.hh" "$VT_REPO/modern/build/vtm_build_number.hh" 2>/dev/null | grep -m1 VTM_BUILD_VERSION | awk '{print $3}' | tr -d '"')
LATEST="${LATEST:-unknown}"
behind=0; line=""
while IFS='|' read -r name ip <&3; do
    [ -z "$ip" ] && continue
    adb connect "$ip:5555" >/dev/null 2>&1 || true
    v=$(adb -s "$ip:5555" shell dumpsys package org.viewtouch.pos 2>/dev/null | awk -F= '/versionName/{print $2; exit}' | tr -d '\r ')
    [ "$v" = "$LATEST" ] || behind=1
    line="$line | $name: ${v:-Offline}"
done 3< <(vt_tablets)
if [ "$behind" = 0 ]; then
  echo "Tablets up to date ($LATEST)$line"
else
  echo "UPDATE READY ($LATEST)$line -> Double-tap 'Tablets (Push)' when ready!"
fi
