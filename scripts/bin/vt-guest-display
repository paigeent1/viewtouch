#!/bin/bash
# The customer display (the guest's order, total, tip choices, price checks) on the Pi's second HDMI.
#   vt-guest-display on    second monitor = customer display (stops mirroring; kept after reboots)
#   vt-guest-display on HDMI-2   the same, and HDMI-2 is the register's monitor (the other the guest's),
#                          whatever order the Pi lists them in (kept in ~/.vt-pos-output)
#   vt-guest-display off   back to mirroring the first monitor on the second
#   vt-guest-display touch the guest monitor is a touchscreen too: touch it once so the Pi learns which
#                          touchscreen is which (both report the same name); remembered by USB port
#   vt-guest-display touch --or-map   the same, and if nobody touches it, tie them as last learned
#                          (Hardware Configuration's "Learn guest touchscreen" button)
# Then ViewTouch restarts (vt-server) so it opens the guest window on the second monitor.
MODE="${1:-on}"
# vt-guest-display on HDMI-2: that monitor is the register (the other one the guest's), kept for good.
if [ "$MODE" = on ] && [ -n "$2" ]; then echo "$2" > "$HOME/.vt-pos-output"; fi
STATE="$HOME/.vt-customer-display"
export DISPLAY="${DISPLAY:-:0}" XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
AUTOSTART="$HOME/.config/autostart/vt-guest-display.desktop"

if [ "$MODE" = touch ]; then
    command -v xinput >/dev/null || { echo "xinput is missing: sudo apt install xinput"; exit 1; }
    ids=$(xinput list | grep -i -E 'touch|ctp|ilitek|goodix|egalax|eeti' | grep -i pointer | grep -o 'id=[0-9]*' | cut -d= -f2 | tr '\n' ' ')
    [ -z "$ids" ] && { echo "No touchscreen found. Is the guest monitor's USB touch cable plugged in?"; exit 1; }
    echo "Touch the GUEST screen (the second monitor) now, within 20 seconds... (tap it a few times)"
    # Line by line (stdbuf: xinput holds back its output in a pipe). An event reads
    # "device: 2 (7)": 2 is the Pi's combined pointer, 7 (in brackets) the touchscreen touched.
    hit=$(timeout 20 stdbuf -oL xinput test-xi2 --root 2>/dev/null | awk -v want=" $ids " '
        /EVENT type/ { ev = $0; next }
        /^[ \t]*device: / {
            if (ev !~ /Touch|ButtonPress|Motion/) next
            for (i = 2; i <= 3; i++) { d = $i; gsub(/[()]/, "", d); if (index(want, " " d " ")) { print d; fflush(); exit } }
        }')
    if [ -z "$hit" ]; then
        if [ "$2" = --or-map ]; then
            vt-touch-map
            (setsid vt-touch-map --watch >/dev/null 2>&1 &)
            echo "No touch on the guest screen: touchscreens tied as last learned. Double-tap again and touch the guest screen to re-learn."
            exit 0
        fi
        echo "No touch seen. Run it again and touch the guest screen."; exit 1
    fi
    node=$(xinput list-props "$hit" | awk -F'"' '/Device Node/{print $2; exit}')
    port=$(udevadm info -q property -n "$node" 2>/dev/null | sed -n 's/^ID_PATH=//p' | sed 's/\(usb-[0-9]*:[0-9.]*\):[0-9]*\.[0-9]*$/\1/')
    [ -z "$port" ] && { echo "Couldn't tell which USB port that touchscreen is on."; exit 1; }
    echo "$port" > "$HOME/.vt-guest-touch"
    VT_TOUCH_VERBOSE=1 vt-touch-map
    (setsid vt-touch-map --watch >/dev/null 2>&1 &)   # and again whenever a touchscreen reconnects
    echo "Guest touchscreen learned (USB port $port): it touches the guest monitor, the other one the POS. Keep it in the same USB port (or learn it again)."
    exit 0
fi

if [ "$MODE" = off ]; then
    rm -f "$STATE" "$AUTOSTART" "$HOME/.config/vt-guest-display.sh"
    pkill -f "vt-touch-map --watc[h]" >/dev/null 2>&1
    sed -i '/<touch .*vt-guest-display/d' "$HOME/.config/labwc/rc.xml" 2>/dev/null; labwc --reconfigure >/dev/null 2>&1 || true
    vt-mirror on || true
    vt-server
    exit 0
fi

# Side by side instead of mirrored: the POS on the first, the guest's screen on the second.
vt-mirror off >/dev/null 2>&1 || true
cmd=""
for wd in "$WAYLAND_DISPLAY" wayland-0 wayland-1; do
    [ -n "$wd" ] && WAYLAND_DISPLAY="$wd" wlr-randr >/dev/null 2>&1 && { export WAYLAND_DISPLAY="$wd"; break; }
done
if command -v wlr-randr >/dev/null && wlr-randr >/dev/null 2>&1; then
    outs=$(wlr-randr | awk '/^[A-Za-z]/{print $1}')
    first=$(echo "$outs" | sed -n 1p); second=$(echo "$outs" | sed -n 2p)
    # The register's monitor, when the store said which (vt-guest-display on HDMI-2): first, whatever the order.
    pos=$(cat "$HOME/.vt-pos-output" 2>/dev/null)
    if [ -n "$pos" ] && echo "$outs" | grep -qx "$pos"; then first="$pos"; second=$(echo "$outs" | grep -vx "$pos" | sed -n 1p); fi
    [ -z "$second" ] && { echo "Only one screen found ($first). Is the second monitor plugged in and on?"; exit 1; }
    w=$(wlr-randr | awk -v o="$first" '$1==o{f=1;next} /^[A-Za-z]/{f=0} f && /current/{split($1,a,"x"); print a[1]; exit}')
    cmd="wlr-randr --output $second --on --preferred --pos ${w:-1920},0"
    LABWC="$HOME/.config/labwc/autostart"
    sed -i "/# vt-guest-display/d" "$LABWC" 2>/dev/null
    mkdir -p "$(dirname "$LABWC")"; echo "(sleep 3; $cmd) & # vt-guest-display" >> "$LABWC"
elif command -v xrandr >/dev/null && xrandr >/dev/null 2>&1; then
    outs=$(xrandr | awk '/ connected/{print $1}')
    first=$(echo "$outs" | sed -n 1p); second=$(echo "$outs" | sed -n 2p)
    # The register's monitor, when the store said which (vt-guest-display on HDMI-2): first, whatever the order.
    pos=$(cat "$HOME/.vt-pos-output" 2>/dev/null)
    if [ -n "$pos" ] && echo "$outs" | grep -qx "$pos"; then first="$pos"; second=$(echo "$outs" | grep -vx "$pos" | sed -n 1p); fi
    [ -z "$second" ] && { echo "Only one screen found ($first). Is the second monitor plugged in and on?"; exit 1; }
    # Each monitor at its own best mode (--auto: its preferred size and rate). Asking for a size by
    # name took the first mode of that size, which on the register was 1280x720 at 48 Hz: a flicker.
    # The register's monitor is the Pi's primary one: ViewTouch opens the register on the primary
    # monitor and the guest's screen on the other, whatever their order.
    cmd="xrandr --output $first --primary --auto; xrandr --output $second --auto --right-of $first"
else
    echo "Couldn't reach the Pi's screen. Run this on the Pi's desktop session."; exit 1
fi
# The touchscreen stays on the POS monitor: spread over both, every touch would land in the wrong place.
if [ -z "$WAYLAND_DISPLAY" ] || ! wlr-randr >/dev/null 2>&1; then
    # Each touchscreen on its own monitor (vt-touch-map: the guest's, learned with `touch`, on the second).
    cmd="$cmd; sleep 1; vt-touch-map || true; (setsid vt-touch-map --watch >/dev/null 2>&1 &)"
else
    # labwc (Wayland): <touch mapToOutput> in rc.xml.
    RC="$HOME/.config/labwc/rc.xml"
    mkdir -p "$(dirname "$RC")"
    [ -f "$RC" ] || printf '<?xml version="1.0"?>\n<labwc_config>\n</labwc_config>\n' > "$RC"
    sed -i '/<touch .*vt-guest-display/d' "$RC"
    sed -i "s|</labwc_config>|  <touch mapToOutput=\"$first\" /> <!-- vt-guest-display -->\n</labwc_config>|" "$RC"
    labwc --reconfigure >/dev/null 2>&1 || true
fi
eval "$cmd" || { echo "Couldn't put $second beside $first"; exit 1; }
mkdir -p "$(dirname "$AUTOSTART")"
# After every reboot: the monitors side by side and the touchscreen on the POS monitor.
BOOT="$HOME/.config/vt-guest-display.sh"
printf '#!/bin/sh\nsleep 3\nexport DISPLAY=:0\n%s\n' "$cmd" > "$BOOT"; chmod +x "$BOOT"
printf '[Desktop Entry]\nType=Application\nName=vt-guest-display\nExec=%s\n' "$BOOT" > "$AUTOSTART"
echo window > "$STATE"
echo "Customer display on $second (the POS stays on $first)."
vt-server
