#!/bin/bash
# A new tablet, plugged into the Pi by USB with USB debugging on: installs the app, kiosk mode,
# pairs it with this site's server and adds it to this site's tablets (vt-site).
#   vt-add-tablet ["Bar 4"] [its Wi-Fi address]
set -e
. "$(dirname "$(readlink -f "$0")")/vt-site-lib"
USB=$(adb devices | awk 'NR>1 && $2=="device" && $1 !~ /:/ {print $1; exit}')
[ -z "$USB" ] && { echo "Plug new tablet into Pi USB port with USB Debugging ON first!"; exit 1; }
COUNT=$(( $(vt_tablets | grep -c .) + 1 ))
NAME="${1:-Bar ${COUNT}}"
IP="${2:-$(adb -s "$USB" shell ip -f inet addr show wlan0 | awk '/inet / {split($2,a,"/"); print a[1]; exit}' | tr -d '\r')}"
SERVER="$(vt_server_addr):$SERVER_PORT"
APK=$(vt_apk arm64-v8a)
[ -z "$APK" ] && { echo "No tablet APK (arm64-v8a) in $VT_REPO/apks/"; exit 1; }
adb -s "$USB" install -r "$APK" >/dev/null
adb -s "$USB" shell dpm set-device-owner org.viewtouch.pos/.KioskAdmin >/dev/null 2>&1 || true
adb -s "$USB" shell "settings put system accelerometer_rotation 0; settings put system user_rotation 1; settings put system screen_off_timeout 2147483647; settings put global adb_wifi_enabled 1; settings put global stay_on_while_plugged_in 7; settings put global wifi_sleep_policy 2"
adb -s "$USB" shell "mkdir -p /sdcard/Android/data/org.viewtouch.pos/files" >/dev/null 2>&1 || true
CODE=$(QT_QPA_PLATFORM=offscreen "$VT_BUILD/vtmodern" --pairing-code 2>&1 | grep -oE '[A-Z0-9]{5}-[A-Z0-9]{5}' | head -n 1)
rm -rf /tmp/vt_pair && mkdir -p /tmp/vt_pair
QT_QPA_PLATFORM=offscreen "$VT_BUILD/vtmodern" --data-dir /tmp/vt_pair --connect "$SERVER" --pair "$CODE" --terminal "$NAME" --pair-only >/dev/null 2>&1
adb -s "$USB" push "$(find /tmp/vt_pair -name "terminal.json" | head -n 1)" /data/local/tmp/terminal.json >/dev/null
adb -s "$USB" tcpip 5555 >/dev/null 2>&1 && sleep 2
if [ -n "$IP" ]; then
    adb connect "$IP:5555" >/dev/null 2>&1 || true
    vt_tablet_set "$NAME" "$IP"
fi
adb -s "$USB" shell am force-stop org.viewtouch.pos
adb -s "$USB" shell am start -n org.viewtouch.pos/org.qtproject.qt.android.bindings.QtActivity >/dev/null 2>&1
echo "✓ Provisioned & paired '$NAME' ($IP) with $SERVER and added to this site's tablets (vt-site)."
