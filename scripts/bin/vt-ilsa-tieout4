#!/usr/bin/env python3
"""ILSA self-check round 4 (dry run): the days where ILSA's Z cash differs from cash tendered minus
change: does the difference equal something else rung that day? Counts and dollars only.
  vt-ilsa-tieout4 ~/ilsa-export/"copy bhdan 10-29-2026"
"""
import csv, os, re, sys
from collections import Counter, defaultdict

csv.field_size_limit(1 << 30)
D = sys.argv[1] if len(sys.argv) > 1 else ""
if not os.path.isdir(D):
    sys.exit("Usage: vt-ilsa-tieout4 ~/ilsa-export/<database name>")

def rows(t):
    for f in os.listdir(D):
        if f.lower() == (t + ".csv").lower():
            with open(os.path.join(D, f), newline="", errors="replace") as fh:
                yield from csv.DictReader(fh)
            return

def num(s):
    try: return float(s)
    except (TypeError, ValueError): return 0.0

US = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{2,4})")
def year(s):
    m = US.match((s or "").strip())
    if not m: return (s or "?")[:4]
    y = int(m.group(3)); return str(y + (2000 if y < 70 else 1900) if y < 100 else y)

zyear = {(r.get("REG_NUM"), r.get("REG_Z_COUNTER")): year(r.get("REG_Z_DATETIME")) for r in rows("RegZCnt")}
zcash = defaultdict(float)
for r in rows("Z_Tender"):
    if r.get("TENDER_TYPE") == "1":
        zcash[(r.get("REG_NUM"), r.get("REG_Z_COUNTER"))] += num(r.get("TENDER_AMT"))

mode = {}
cand = defaultdict(lambda: defaultdict(float))   # z -> candidate -> $
for r in rows("RegSale"):
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER")); m = r.get("Z_MODE")
    mode[(k, r.get("RECEIPT_NUM"))] = m
    if m == "1": cand[k]["mode-1 receipts total"] += num(r.get("SALE_TOTAL"))
cash = defaultdict(float)
for r in rows("TENDSALE"):
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER")); ty = r.get("TENDER_TYPE")
    a, t, c = num(r.get("SALE_AMT")), num(r.get("AMT_TEND")), num(r.get("CHANGE_DUE"))
    if ty == "1":
        cash[k] += t - c
        if a < 0: cand[k]["cash refund rows (AMT_TEND)"] += t
    else:
        cand[k]["change given on non-cash tenders"] += c
for r in rows("RegReconcile"):   # ILSA's drawer counts per register Z: paid outs, paid ins, drops
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER"))
    for c in ("Z_PAYOUTS", "Z_PAYINS", "Z_SAFEDROPS", "CSHR_PAYOUTS", "CSHR_PAYINS"):
        cand[k]["RegReconcile " + c] += num(r.get(c))
for r in rows("TENDSALE"):        # negative cash rows split by what ILSA's receipt says they were
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER"))
    if r.get("TENDER_TYPE") == "1" and num(r.get("SALE_AMT")) < 0:
        m = mode.get((k, r.get("RECEIPT_NUM")), "?")
        cand[k][f"cash refund rows on mode-{m} receipts"] += num(r.get("AMT_TEND"))
for r in rows("MDetail"):
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER")); cand[k]["MDetail (dept 0 entries)"] += num(r.get("DETAIL_AMT"))
for r in rows("PDetail"):
    k = (r.get("REG_NUM"), r.get("REG_Z_COUNTER")); c, t = r.get("DETAIL_CLASS"), r.get("DETAIL_TYPE")
    a = num(r.get("DETAIL_LINE_AMT"))
    if (c, t) == ("30", "30"): cand[k]["lines 30/30"] += a
    if (c, t) == ("1", "6"): cand[k]["negative dept entries 1/6"] += a
    if (c, t) == ("4", "1"): cand[k]["lines 4/1"] += a
    if mode.get((k, r.get("RECEIPT_NUM"))) == "1": cand[k]["lines on mode-1 receipts"] += a

bad = [k for k in zcash if abs(zcash[k] - cash[k]) >= 0.015]
print(f"Days where Z cash != cash tendered - change: {len(bad)} of {len(zcash)}")
print("By year:", dict(sorted(Counter(zyear.get(k, "?") for k in bad).items())))
names = sorted({n for k in bad for n in cand[k]})
print("\n== On those days, the difference (Z - receipts) equals...")
for n in names:
    hit = sum(1 for k in bad if abs((zcash[k] - cash[k]) - cand[k].get(n, 0.0)) < 0.015)
    neg = sum(1 for k in bad if abs((zcash[k] - cash[k]) + cand[k].get(n, 0.0)) < 0.015)
    tot = sum(cand[k].get(n, 0.0) for k in bad)
    print(f"  {n}: equals it on {hit} days, equals minus it on {neg} days (its total on those days ${tot:,.2f})")
# pairs
print("\n== ...or the sum of two of them")
for i, a in enumerate(names):
    for b in names[i + 1:]:
        hit = sum(1 for k in bad if abs((zcash[k] - cash[k]) - cand[k].get(a, 0.0) - cand[k].get(b, 0.0)) < 0.015)
        if hit: print(f"  {a} + {b}: {hit} days")
diffs = sorted(((zcash[k] - cash[k]), zyear.get(k, "?")) for k in bad)
print("\nSmallest and largest differences:", [f"{y} {d:+,.2f}" for d, y in diffs[:5]], [f"{y} {d:+,.2f}" for d, y in diffs[-5:]])
print("\nDone. Paste everything above to Bob.")
