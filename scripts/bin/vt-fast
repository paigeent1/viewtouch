#!/bin/bash
set -e
cd ~/viewtouch-main/modern
cmake --build build --target vtmodern -j3
sudo cp -f build/vtmodern /usr/local/bin/vtmodern
killall -9 vtmodern 2>/dev/null || true; sleep 0.5
WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/$(id -u) DISPLAY=:0 ~/viewtouch-main/modern/build/vtmodern --serve >/dev/null 2>&1 &
echo "✓ vtmodern rebuilt and restarted! ($(ccache -s | grep -E 'Hits|Hit rate' | tr '\n' ' '))"
