#!/usr/bin/env python3
"""TVs and DIRECTV receivers on the store network, worked over the network.

  vt-directv <box|all> tune <channel>     DIRECTV: change the channel
  vt-directv <box|all> key <key>          a remote key (chanup, chandown, prev, guide,
                                          exit, info, select, poweron, poweroff...)
  vt-directv scan [--save] [subnet]       find DIRECTV receivers and smart TVs
                                          (SSDP, then a sweep of the subnet)
  vt-directv list                         the TVs this script knows

The TV list is ~/.config/viewtouch/tvs.json (not in the repo, not in the
database). Without it the five bar receivers below are used. `scan --save`
adds what it finds, keeping the names already there.

This script never writes ViewTouch's database or its pages (it used to; that
froze the screen and fought with the editor — audit 2026-11-04). The DIRECTV
pages are ordinary pages in seed/pages, edited in the layout editor.

DIRECTV receivers need "External Device Access" allowed (Menu > Settings >
Whole-Home > External Device). Roku TVs are worked over ECP (port 8060).
Samsung, LG webOS, Sony Bravia and Android/Google TVs are found and listed;
working them needs a one-time pairing on the TV (not done here yet).
"""
import concurrent.futures
import ipaddress
import json
import os
import pathlib
import re
import socket
import subprocess
import sys
import urllib.error
import urllib.request

CONFIG = pathlib.Path(os.path.expanduser("~/.config/viewtouch/tvs.json"))
DEFAULT_TVS = {
    "front": {"name": "BAR FRONT", "kind": "directv", "ip": "192.168.6.70"},
    "bar1":  {"name": "BAR 1",     "kind": "directv", "ip": "192.168.6.74"},
    "bar2":  {"name": "BAR 2",     "kind": "directv", "ip": "192.168.6.71"},
    "box72": {"name": "BOX .72",   "kind": "directv", "ip": "192.168.6.72"},
    "vip":   {"name": "VIP",       "kind": "directv", "ip": "192.168.6.73"},
}
CHANNELS = {
    "206": "ESPN", "209": "ESPN2", "219": "FS1", "212": "NFL Net",
    "213": "MLB Net", "216": "NBA TV", "215": "NHL Net", "221": "CBS Sports",
    "631": "YES Net", "639": "SNY", "634": "MSG", "628": "NESN",
    "245": "TNT", "247": "TBS", "242": "USA", "218": "Golf",
    "703": "RedZone", "610": "BTN", "202": "CNN", "360": "Fox News",
}
# Our key names -> Roku ECP keys.
ROKU_KEYS = {
    "chanup": "ChannelUp", "chandown": "ChannelDown", "poweron": "PowerOn", "poweroff": "PowerOff",
    "select": "Select", "exit": "Back", "info": "Info", "guide": "Home", "prev": "InstantReplay",
    "volup": "VolumeUp", "voldown": "VolumeDown", "mute": "VolumeMute",
}
FREQ_FILE = pathlib.Path(os.path.expanduser("~/.local/share/ViewTouch/ViewTouch/directv_freq.json"))


def load_tvs():
    try:
        tvs = json.loads(CONFIG.read_text())
        if isinstance(tvs, dict) and tvs:
            return tvs
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"Couldn't read {CONFIG}: {e} (using the built-in list)", file=sys.stderr)
    return dict(DEFAULT_TVS)


def http(url, method="GET", timeout=2.0):
    req = urllib.request.Request(url, method=method, data=b"" if method == "POST" else None)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.status, r.read().decode("utf-8", errors="ignore")


# --- working a TV ----------------------------------------------------------------------

def directv(ip, op, val):
    path = f"/tv/tune?major={val}" if op == "tune" else f"/remote/processKey?key={val}"
    try:
        _, body = http(f"http://{ip}:8080{path}")
        code = json.loads(body).get("status", {}).get("code", 200)
    except urllib.error.HTTPError as e:
        code = e.code
    except Exception as e:
        return f"not reachable ({e.__class__.__name__})"
    if code == 403:
        return "locked (allow External Device Access on the receiver)"
    if code != 200:
        return f"refused ({code})"
    return f"-> {CHANNELS.get(val, val)} ({val})" if op == "tune" else f"{val} sent"


def roku(ip, op, val):
    try:
        if op == "tune":
            # A Roku TV's own tuner: the channel as digits, then Select.
            for d in str(val):
                http(f"http://{ip}:8060/keypress/Lit_{d}", "POST")
            http(f"http://{ip}:8060/keypress/Select", "POST")
            return f"-> channel {val}"
        http(f"http://{ip}:8060/keypress/{ROKU_KEYS.get(val, val)}", "POST")
        return f"{val} sent"
    except Exception as e:
        return f"not reachable ({e.__class__.__name__})"


def work(tv, op, val):
    kind = tv.get("kind", "directv")
    if kind == "directv":
        return directv(tv["ip"], op, val)
    if kind == "roku":
        return roku(tv["ip"], op, val)
    return f"{kind} TVs need pairing first (not done yet)"


def count_channel(val):
    try:
        freq = json.loads(FREQ_FILE.read_text()) if FREQ_FILE.exists() else {}
        freq[val] = freq.get(val, 0) + 1
        FREQ_FILE.parent.mkdir(parents=True, exist_ok=True)
        FREQ_FILE.write_text(json.dumps(freq, indent=2))
    except Exception:
        pass   # only a tally


# --- finding TVs ---------------------------------------------------------------------------

def classify(text):
    t = text.lower()
    if "directv" in t or "shef" in t:
        return "directv"
    if "roku" in t:
        return "roku"
    if "webos" in t or "lge" in t or "lg electronics" in t:
        return "lg"
    if "samsung" in t:
        return "samsung"
    if "sony" in t or "bravia" in t:
        return "sony"
    if "google" in t or "chromecast" in t or "android" in t:
        return "androidtv"
    if "vizio" in t:
        return "vizio"
    return ""


def ssdp(timeout=3.0):
    """Ask everything on the network that answers SSDP who it is."""
    found = {}
    msg = ("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\nMAN: \"ssdp:discover\"\r\n"
           "MX: 2\r\nST: {}\r\n\r\n")
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
    s.settimeout(0.5)
    for st in ("ssdp:all", "roku:ecp", "urn:schemas-upnp-org:device:MediaRenderer:1",
               "urn:dial-multiscreen-org:service:dial:1"):
        try:
            s.sendto(msg.format(st).encode(), ("239.255.255.250", 1900))
        except OSError:
            pass
    import time
    end = time.time() + timeout
    while time.time() < end:
        try:
            data, (ip, _) = s.recvfrom(4096)
        except socket.timeout:
            continue
        except OSError:
            break
        text = data.decode("utf-8", errors="ignore")
        found.setdefault(ip, []).append(text)
    s.close()
    out = {}
    for ip, answers in found.items():
        blob = "\n".join(answers)
        kind = classify(blob)
        name = ""
        loc = re.search(r"(?im)^location:\s*(\S+)", blob)
        if loc:
            try:
                _, xml = http(loc.group(1), timeout=1.5)
                kind = kind or classify(xml)
                m = re.search(r"<friendlyName>([^<]+)</friendlyName>", xml)
                name = m.group(1).strip() if m else ""
            except Exception:
                pass
        if kind:
            out[ip] = {"kind": kind, "name": name, "how": "ssdp"}
    return out


def probe(ip):
    """A receiver or TV that doesn't answer SSDP: try the ports they listen on."""
    ip = str(ip)
    try:
        _, body = http(f"http://{ip}:8080/info/getVersion", timeout=0.8)
        if "receiverId" in body or "stbSoftwareVersion" in body:
            return ip, {"kind": "directv", "name": "", "how": "port 8080"}
    except Exception:
        pass
    try:
        _, body = http(f"http://{ip}:8060/query/device-info", timeout=0.8)
        m = re.search(r"<user-device-name>([^<]*)<", body) or re.search(r"<friendly-device-name>([^<]*)<", body)
        return ip, {"kind": "roku", "name": m.group(1) if m else "", "how": "port 8060"}
    except Exception:
        pass
    for port, kind in ((8001, "samsung"), (3000, "lg"), (8008, "androidtv")):
        try:
            with socket.create_connection((ip, port), timeout=0.4):
                return ip, {"kind": kind, "name": "", "how": f"port {port}"}
        except OSError:
            pass
    return ip, None


def local_subnets():
    nets = []
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=3).stdout
        for m in re.finditer(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", out):
            net = ipaddress.ip_interface(m.group(1)).network
            if net.prefixlen < 24:          # don't sweep a /16: its /24
                net = ipaddress.ip_interface(m.group(1).split("/")[0] + "/24").network
            nets.append(net)
    except Exception:
        pass
    return nets


def scan(save, subnets):
    print("Looking for DIRECTV receivers and smart TVs (about 30 seconds)...")
    found = ssdp()
    hosts = [h for net in subnets for h in net.hosts()]
    with concurrent.futures.ThreadPoolExecutor(64) as pool:
        for ip, hit in pool.map(probe, hosts):
            if hit and ip not in found:
                found[ip] = hit
            elif hit and ip in found and not found[ip].get("kind"):
                found[ip].update(hit)
    tvs = load_tvs()
    by_ip = {tv.get("ip"): key for key, tv in tvs.items()}
    if not found:
        print("Nothing found. Is this computer on the TVs' network? (" +
              ", ".join(map(str, subnets)) + " swept)")
        return
    for ip in sorted(found, key=lambda a: tuple(int(p) for p in a.split("."))):
        f = found[ip]
        known = by_ip.get(ip)
        label = tvs[known]["name"] if known else (f["name"] or "(new)")
        works = "works now" if f["kind"] in ("directv", "roku") else "needs pairing"
        print(f"  {ip:15}  {f['kind']:9}  {label:24}  {works}  [{f['how']}]")
        if save and not known:
            key = re.sub(r"[^a-z0-9]+", "-", (f["name"] or f"{f['kind']}-{ip.split('.')[-1]}").lower()).strip("-")
            while key in tvs:
                key += "-2"
            tvs[key] = {"name": f["name"] or f"{f['kind'].upper()} .{ip.split('.')[-1]}", "kind": f["kind"], "ip": ip}
        elif save and known and tvs[known].get("kind") != f["kind"]:
            tvs[known]["kind"] = f["kind"]
    if save:
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(json.dumps(tvs, indent=2) + "\n")
        print(f"Saved {len(tvs)} TVs to {CONFIG} (rename them there).")
    else:
        print("Run with --save to add the new ones to the TV list.")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--init-pages":
        print("vt-directv no longer writes pages; edit the DIRECTV pages in the layout editor.")
        return 0
    if argv[0] == "list":
        for key, tv in load_tvs().items():
            print(f"  {key:10}  {tv.get('kind', 'directv'):9}  {tv.get('ip', ''):15}  {tv.get('name', '')}")
        return 0
    if argv[0] == "scan":
        save = "--save" in argv
        nets = [ipaddress.ip_network(a, strict=False) for a in argv[1:] if a != "--save"]
        if not nets:
            # This computer's networks, and the ones the known TVs are on (the
            # bar receivers are on 192.168.6.x, not the POS network).
            nets = local_subnets()
            for tv in load_tvs().values():
                try:
                    net = ipaddress.ip_interface(tv.get("ip", "") + "/24").network
                except ValueError:
                    continue
                if net not in nets:
                    nets.append(net)
        scan(save, nets)
        return 0

    box = argv[0]
    op = argv[1] if len(argv) > 1 else "tune"
    val = argv[2] if len(argv) > 2 else "206"
    if op not in ("tune", "key") or not re.fullmatch(r"[A-Za-z0-9_]{1,24}", val):
        print("Usage: vt-directv <box|all> tune <channel> | key <key>")
        return 2
    tvs = load_tvs()
    if box == "all":
        targets = [k for k, tv in tvs.items() if tv.get("kind", "directv") == "directv"]
    elif box in tvs:
        targets = [box]
    else:
        print(f"No TV called {box} (vt-directv list)")
        return 2
    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        results = list(pool.map(lambda k: (k, work(tvs[k], op, val)), targets))
    if op == "tune" and val.isdigit():
        count_channel(val)
    print(" | ".join(f"{tvs[k].get('name', k)}: {r}" for k, r in results))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
