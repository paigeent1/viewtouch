#!/usr/bin/env python3
"""ILSA price book -> a ViewTouch menu file (Menu Builder > Import a menu), plus a merge report.
  vt-ilsa-items [--history ~/ilsa-export/"copy bhdan 10-29-2026"]
Reads ~/ilsa-pricebook/latest (what the ILSA computer sends). Every item (ILSA's ACTIVE flag is
ignored), except lottery. One category per ILSA department. Tax: ILSA's POS flag (tax group 1 =
merchandise, otherwise none). Items with the same name in the same department are ONE item: every
UPC becomes one of its barcodes; its price is the price of the UPC that sold most recently (with
--history; else the highest), and each merge is listed for review. No quantities on hand.
Writes ~/ilsa-items/viewtouch-menu.json, merges.csv and summary.txt.
"""
import csv, json, os, re, sys
from collections import Counter, defaultdict

csv.field_size_limit(1 << 30)
BOOK = os.path.expanduser("~/ilsa-pricebook/latest")
OUT = os.path.expanduser("~/ilsa-items")
LOTTERY = {"270", "275", "280", "300", "320", "340", "345", "360", "365", "370", "375", "377", "378", "379",
           "380", "400", "405", "420"}

def rows(d, t):
    for f in os.listdir(d):
        if f.lower() == (t + ".csv").lower():
            with open(os.path.join(d, f), newline="", encoding="utf-8-sig", errors="replace") as fh:
                yield from csv.DictReader(fh)
            return

def num(s):
    try: return round(float((s or "").replace("$", "").replace(",", "").strip()), 2)
    except ValueError: return 0.0

def clean(s): return re.sub(r"\s+", " ", (s or "").strip())
def code(s):
    s = (s or "").strip()
    return s[:-2] if s.endswith(".0") and s[:-2].isdigit() else s

if not os.path.isdir(BOOK):
    sys.exit("No price book yet: run vt-ilsa-pricebook first.")

# --- last sale per UPC (optional, from the ILSA history export) --------------------------------
last_sold = {}
if "--history" in sys.argv:
    h = sys.argv[sys.argv.index("--history") + 1]
    US = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{2,4})")
    for r in rows(h, "PDetail"):
        if (r.get("DETAIL_CLASS"), r.get("DETAIL_TYPE")) != ("1", "1"):
            continue
        t = (r.get("TIME_STAMP") or "").strip(); m = US.match(t)
        if m:
            mo, d, y = m.groups(); y = int(y); y += (2000 if y < 70 else 1900) if y < 100 else 0
            t = f"{y:04d}-{int(mo):02d}-{int(d):02d}"
        u = code(r.get("PLU"))
        if u and t > last_sold.get(u, ""):
            last_sold[u] = t

# --- departments, tax --------------------------------------------------------------------------
dept = {code(r.get("DEPT_NUM")): clean(r.get("DEPT_NAME") or r.get("POS_DESC")) for r in rows(BOOK, "Dept")}
taxgroup = {clean(r.get("POS_FLAG_NAME")).upper(): code(r.get("TAX_GROUP")) for r in rows(BOOK, "Pos_Flag")}
agereq = {clean(r.get("POS_FLAG_NAME")).upper(): code(r.get("AGE_REQ")) for r in rows(BOOK, "Pos_Flag")}

def slug(s): return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-") or "x"

# --- items -------------------------------------------------------------------------------------
groups = defaultdict(list)   # (dept, NAME) -> ILSA items
skipped = Counter()
for r in rows(BOOK, "PLU"):
    upc = code(r.get("PLU_NUM"))
    if not upc:
        skipped["no UPC"] += 1; continue
    d = code(r.get("DEPT_NUM"))
    if d in LOTTERY:
        skipped["lottery"] += 1; continue
    name = clean(r.get("PLU_DESC")) or clean(r.get("POS_DESC")) or f"ITEM {upc}"
    flag = clean(r.get("POS_FLAG_NAME")).upper()
    codes = [upc] + [c for c in (code(r.get("Alt_PLUNum")), code(r.get("UPC_E"))) if c and c != upc]
    groups[(d, name.upper())].append({"upc": upc, "codes": codes, "name": name, "price": num(r.get("LAST_PRICE")),
                                      "tax": taxgroup.get(flag, "1"), "age": agereq.get(flag, "0"), "flag": flag})

cats, items, merges, tobacco_cats = {}, [], [], set()
used_codes = set()
for (d, _), g in sorted(groups.items()):
    cname = dept.get(d) or f"DEPT {d or '?'}"
    cid = "ilsa-" + slug(cname)
    cats[cid] = {"id": cid, "name": cname, "taxClass": "merchandise"}
    g.sort(key=lambda x: (last_sold.get(x["upc"], ""), x["price"]), reverse=True)
    keep = g[0]
    barcodes = []
    for x in g:
        for c in x["codes"]:
            if c not in used_codes:
                used_codes.add(c); barcodes.append(c)
    if not barcodes:
        continue   # every code already on another item
    items.append({"id": "ilsa-" + keep["upc"], "name": keep["name"], "price": keep["price"],
                  "taxClass": "merchandise" if keep["tax"] == "1" else "none", "family": cid, "barcodes": barcodes})
    if keep["age"] not in ("", "0"):
        tobacco_cats.add(cname)
    if len(g) > 1:
        prices = sorted({x["price"] for x in g})
        merges.append([cname, keep["name"], len(g), " ".join(x["upc"] for x in g), keep["upc"],
                       f"{keep['price']:.2f}", " / ".join(f"{p:.2f}" for p in prices),
                       "PRICES DIFFER" if len(prices) > 1 else "", last_sold.get(keep["upc"], "")])

os.makedirs(OUT, exist_ok=True)
book = {"format": "viewtouch-menu", "version": 1, "store": "ILSA price book",
        "exported": open(os.path.join(BOOK, "manifest.txt")).read().split("\n")[0].replace("exported=", "") if os.path.exists(os.path.join(BOOK, "manifest.txt")) else "",
        "categories": sorted(cats.values(), key=lambda c: c["name"]), "choiceGroups": [], "items": items, "pictures": {}}
with open(os.path.join(OUT, "viewtouch-menu.json"), "w") as f:
    json.dump(book, f)
with open(os.path.join(OUT, "merges.csv"), "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["Department", "Name kept", "ILSA items", "UPCs", "Price from UPC", "Price", "All prices", "Check", "Last sold"])
    w.writerows(sorted(merges))
by_cat = Counter(i["family"] for i in items)
lines = [f"ILSA items read: {sum(len(g) for g in groups.values()) + sum(skipped.values())}; left out: {dict(skipped)}",
         f"ViewTouch items: {len(items)} in {len(cats)} categories; barcodes {sum(len(i['barcodes']) for i in items)}",
         f"Same-name items merged: {len(merges)} groups ({sum(m[2] for m in merges)} ILSA items); with different prices: {sum(1 for m in merges if m[7])}",
         f"Departments with ID-check (age) items: {', '.join(sorted(tobacco_cats)) or 'none'}",
         "Items per category:"] + [f"  {cats[c]['name']}: {n}" for c, n in sorted(by_cat.items(), key=lambda kv: -kv[1])]
open(os.path.join(OUT, "summary.txt"), "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
print(f"\nWrote {OUT}/viewtouch-menu.json (Menu Builder > Import a menu) and {OUT}/merges.csv")
