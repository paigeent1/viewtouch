#!/usr/bin/env python3
"""ILSA price book -> a ViewTouch menu file (Menu Builder > Import a menu), plus review reports.
  vt-ilsa-items [--history ~/ilsa-export/"copy bhdan 10-29-2026"]
Reads ~/ilsa-pricebook/latest (what the ILSA computer sends). One ViewTouch item per ILSA item:
NOTHING is merged (the owner decides merges himself). ILSA's ACTIVE flag is ignored; lottery and vapor
(no longer sold) are left out: history only. One category per ILSA department. Tax: ILSA's POS flag (tax group 1 = merchandise, otherwise
none). Barcodes: PLU_NUM + Alt_PLUNum + UPC_E. No quantities on hand.
Cost: PLU.LAST_COST (the owner's system cost, list + OTP, kept in ILSA) as "cost"; none when 0 or blank
(AVG_COST is empty in practice).
Writes ~/ilsa-items/viewtouch-menu.json (and viewtouch-menu-part1.json... to import), and for review:
  possible-duplicates.csv  same name in the same department, each with its UPC, price, last sale
  inhouse-upcs.csv         the store's own UPCs (708694...): item, last sold, and any same-name item
                           with a maker's UPC (a candidate to free the in-house code)
  summary.txt
"""
import csv, io, json, os, re, sys
from collections import Counter, defaultdict

csv.field_size_limit(1 << 30)
BOOK = os.path.expanduser("~/ilsa-pricebook/latest")
OUT = os.path.expanduser("~/ilsa-items")
INHOUSE = "708694"
LOTTERY = {"270", "275", "280", "300", "320", "340", "345", "360", "365", "370", "375", "377", "378", "379",
           "380", "400", "405", "420"}
RETIRED = {"55": "vapor", "56": "vapor"}   # departments no longer sold: history only (owner 2026-11-05)

def rows(d, t):
    # UTF-8, else Windows-1252: the ILSA computer's Jet text export writes the Windows character set,
    # so a ½ or ° in a name came out as � when read as UTF-8 ("CASIN 89�PP").
    for f in os.listdir(d):
        if f.lower() == (t + ".csv").lower():
            data = open(os.path.join(d, f), "rb").read()
            try:
                text = data.decode("utf-8-sig")
            except UnicodeDecodeError:
                text = data.decode("cp1252", errors="replace")
            yield from csv.DictReader(io.StringIO(text, newline=""))
            return

def num(s):
    try: return round(float((s or "").replace("$", "").replace(",", "").strip()), 2)
    except ValueError: return 0.0

def clean(s): return re.sub(r"\s+", " ", (s or "").strip())
def code(s):
    s = (s or "").strip()
    return s[:-2] if s.endswith(".0") and s[:-2].isdigit() else s
def slug(s): return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-") or "x"

if not os.path.isdir(BOOK):
    sys.exit("No price book yet: run vt-ilsa-pricebook first.")

last_sold = {}
if "--history" in sys.argv:
    h = sys.argv[sys.argv.index("--history") + 1]
    US = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{2,4})")
    for r in rows(h, "PDetail"):
        if (r.get("DETAIL_CLASS"), r.get("DETAIL_TYPE")) != ("1", "1"):
            continue
        t = (r.get("TIME_STAMP") or "").strip(); m = US.match(t)
        if m:
            mo, d, y = m.groups(); y = int(y); y += (2000 if y < 70 else 1900) if y < 100 else 0
            t = f"{y:04d}-{int(mo):02d}-{int(d):02d}"
        u = code(r.get("PLU"))
        if u and t > last_sold.get(u, ""):
            last_sold[u] = t

dept = {code(r.get("DEPT_NUM")): clean(r.get("DEPT_NAME") or r.get("POS_DESC")) for r in rows(BOOK, "Dept")}
# Each department's group (CIGARS...), and each item's maker, product group and sub group: the Labels tree.
grp_name = {code(r.get("DEPT_GROUP")): clean(r.get("DEPT_GRP_NAME")).upper() for r in rows(BOOK, "Dept_Grp")}
dept_grp = {code(r.get("DEPT_NUM")): grp_name.get(code(r.get("DEPT_GROUP")), "") for r in rows(BOOK, "Dept")}
taxgroup = {clean(r.get("POS_FLAG_NAME")).upper(): code(r.get("TAX_GROUP")) for r in rows(BOOK, "Pos_Flag")}
agereq = {clean(r.get("POS_FLAG_NAME")).upper(): code(r.get("AGE_REQ")) for r in rows(BOOK, "Pos_Flag")}

groups = defaultdict(list)   # (dept, NAME) -> ILSA items (only to report look-alikes)
skipped = Counter()
for r in rows(BOOK, "PLU"):
    upc = code(r.get("PLU_NUM"))
    if not upc:
        skipped["no UPC"] += 1; continue
    d = code(r.get("DEPT_NUM"))
    if d in LOTTERY:
        skipped["lottery"] += 1; continue
    if d in RETIRED:
        skipped[RETIRED[d]] += 1; continue
    name = clean(r.get("PLU_DESC")) or clean(r.get("POS_DESC")) or f"ITEM {upc}"
    flag = clean(r.get("POS_FLAG_NAME")).upper()
    codes = []
    for c in [upc, code(r.get("Alt_PLUNum")), code(r.get("UPC_E"))]:
        # ILSA keeps codes as numbers, so a UPC's leading 0 is lost (016165009116 -> 16165009116):
        # the item also gets the code as scanners send it (12-digit UPC-A, and 13-digit EAN for those).
        for v in ([c, "0" + c] if c.isdigit() and len(c) == 11 else
                  [c, c[1:]] if c.isdigit() and len(c) == 13 and c.startswith("0") else [c]):
            if v and v not in codes:
                codes.append(v)
    groups[(d, name.upper())].append({"upc": upc, "codes": codes, "name": name, "price": num(r.get("LAST_PRICE")),
                                      "cost": num(r.get("LAST_COST")),
                                      "tax": taxgroup.get(flag, "1"), "age": agereq.get(flag, "0"),
                                      "mfg": clean(r.get("MANUF")).upper(), "pg": clean(r.get("PROD_GRP")).upper(),
                                      "sg": clean(r.get("SUBGROUP")).upper()})

cats, items, dups, inhouse, tobacco_cats = {}, [], [], [], set()
used, clashes = set(), 0
for (d, _), g in sorted(groups.items()):
    cname = dept.get(d) or f"DEPT {d or '?'}"
    cid = "ilsa-" + slug(cname)
    cats[cid] = {"id": cid, "name": cname, "taxClass": "merchandise"}
    if dept_grp.get(d):
        cats[cid]["group"] = dept_grp[d]
    for x in g:
        barcodes = [c for c in x["codes"] if c not in used]
        clashes += len(x["codes"]) - len(barcodes)
        used.update(barcodes)
        item = {"id": "ilsa-" + x["upc"], "name": x["name"], "price": x["price"],
                "taxClass": "merchandise" if x["tax"] == "1" else "none", "family": cid, "barcodes": barcodes}
        if x["cost"] > 0:   # ILSA's LAST_COST; 0 / blank: no cost (never sent as 0)
            item["cost"] = x["cost"]
        if x["mfg"] and x["mfg"] != "GENERAL" and not x["mfg"].isdigit():
            item["manufacturer"] = x["mfg"]
        if x["pg"]:
            item["productGroup"] = x["pg"]
            if x["sg"]:
                item["subGroup"] = x["sg"]
        items.append(item)
        if x["age"] not in ("", "0"):
            tobacco_cats.add(cname)
            cats[cid]["idCheck"] = True   # ViewTouch asks for an ID on its items (Site Setup's tobacco list)
        if x["upc"].startswith(INHOUSE):
            makers = [y["upc"] for y in g if not y["upc"].startswith(INHOUSE)]
            inhouse.append([x["upc"], cname, x["name"], f"{x['price']:.2f}", last_sold.get(x["upc"], "never"),
                            " ".join(makers), "candidate to free" if makers else ""])
    if len(g) > 1:
        g = sorted(g, key=lambda x: last_sold.get(x["upc"], ""), reverse=True)
        dups.append([cname, g[0]["name"], len(g)] + [f"{x['upc']} ${x['price']:.2f} last sold {last_sold.get(x['upc'], 'never')}" for x in g])

os.makedirs(OUT, exist_ok=True)
man = os.path.join(BOOK, "manifest.txt")
book = {"format": "viewtouch-menu", "version": 1, "store": "ILSA price book",
        "exported": open(man).readline().strip().replace("exported=", "") if os.path.exists(man) else "",
        "categories": sorted(cats.values(), key=lambda c: c["name"]), "choiceGroups": [], "items": items, "pictures": {}}
with open(os.path.join(OUT, "viewtouch-menu.json"), "w") as f:
    json.dump(book, f)
# Menu Builder > Import reads files up to 4 MB: also in parts of about 8,000 items. Items with the same
# name stay in the same part (the import skips a name already on the menu, so a later part would drop them).
for old in os.listdir(OUT):
    if re.fullmatch(r"viewtouch-menu-part\d+\.json", old):
        os.remove(os.path.join(OUT, old))
same_name = defaultdict(list)
for it in items:
    same_name[it["name"].upper()].append(it)
parts = [[]]
for g in same_name.values():
    if parts[-1] and len(parts[-1]) + len(g) > 8000:
        parts.append([])
    parts[-1] += g
for n, p in enumerate(parts, 1):
    with open(os.path.join(OUT, f"viewtouch-menu-part{n}.json"), "w") as f:
        json.dump(dict(book, items=p), f)
with open(os.path.join(OUT, "possible-duplicates.csv"), "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["Department", "Name", "ILSA items", "Item 1 (most recent sale)", "Item 2", "Item 3", "More..."])
    w.writerows(sorted(dups))
with open(os.path.join(OUT, "inhouse-upcs.csv"), "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["In-house UPC", "Department", "Name", "Price", "Last sold", "Same-name items with a maker's UPC", "Note"])
    w.writerows(sorted(inhouse, key=lambda r: (r[6] == "", r[4])))
by_cat = Counter(i["family"] for i in items)
lines = [f"ILSA items read: {sum(len(g) for g in groups.values()) + sum(skipped.values())}; left out: {dict(skipped)}",
         f"ViewTouch items: {len(items)} in {len(cats)} categories (nothing merged); barcodes {sum(len(i['barcodes']) for i in items)}"
         + (f"; {clashes} codes were on two ILSA items and kept on the first only" if clashes else ""),
         f"Same name in the same department (for your review): {len(dups)} groups, {sum(r[2] for r in dups)} items",
         f"In-house UPCs ({INHOUSE}...): {len(inhouse)} items; {sum(1 for r in inhouse if r[6])} have a same-name item with a maker's UPC (candidates to free); {sum(1 for r in inhouse if r[4] == 'never')} never sold",
         f"Departments with ID-check (age) items: {', '.join(sorted(tobacco_cats)) or 'none'}",
         "Items per category:"] + [f"  {cats[c]['name']}: {n}" for c, n in sorted(by_cat.items(), key=lambda kv: -kv[1])]
open(os.path.join(OUT, "summary.txt"), "w").write("\n".join(lines) + "\n")
print("\n".join(lines))
print(f"\nWrote {OUT}/viewtouch-menu.json (not imported yet), possible-duplicates.csv, inhouse-upcs.csv")
print("To import (Menu Builder > Import a menu, one at a time): " + ", ".join(
    f"viewtouch-menu-part{n}.json ({len(p)} items)" for n, p in enumerate(parts, 1)))
