#!/bin/bash
rm -f /tmp/apply_changes.py /tmp/output.txt /tmp/done
rclone deletefile "gdrive:POS project tmp/done" 2>/dev/null || true
echo "1. Pulling apply_changes.py from Google Drive..."
rclone copy "gdrive:POS project tmp/apply_changes.py" /tmp/
if [ ! -f /tmp/apply_changes.py ]; then
    echo "ERROR: apply_changes.py not found in gdrive:POS project tmp/" | tee /tmp/output.txt
    rclone copy /tmp/output.txt "gdrive:POS project tmp/"
    exit 1
fi
echo "2. Running apply_changes.py..."
python3 /tmp/apply_changes.py 2>&1 | tee /tmp/output.txt
{
    echo ""
    echo "=== AUTO-DIAGNOSTIC FOOTER ($(date +'%Y-%m-%d %H:%M:%S')) ==="
    echo "--- Active Processes ---"
    ps aux | grep -E "[v]tmodern" || true
    echo "--- Git Status ---"
    git -C /home/pi/viewtouch-main status -sb 2>/dev/null || true
} >> /tmp/output.txt
rclone copy /home/pi/viewtouch-main/modern/tools/vt_label_utility.py "gdrive:POS project tmp/" 2>/dev/null || true
echo "3. Syncing output.txt, vt_barcode_wizard.py, and 'done' marker to Google Drive..."
rclone copy /tmp/output.txt "gdrive:POS project tmp/"
date +"COMPLETED %Y-%m-%d %H:%M:%S" > /tmp/done
rclone copy /tmp/done "gdrive:POS project tmp/"
echo "✓ Done! Uploaded output.txt and 'done' marker to Google Drive!"

# --- 4. AUDIO ALERT ROUTED THROUGH HDMI ---
# Generate 3 loud 880Hz sine beeps into a temporary wav file
python3 -c '
import math, struct, wave
sample_rate = 44100
freq = 880.0
dur = 0.16
samples = int(sample_rate * dur)
fade = int(sample_rate * 0.01)
buf = bytearray()
for i in range(samples):
    val = math.sin(2.0 * math.pi * freq * (i / sample_rate))
    if i < fade: val *= (i / fade)
    elif i > samples - fade: val *= ((samples - i) / fade)
    buf += struct.pack("<h", int(val * 32767))
silence = struct.pack("<h", 0) * int(sample_rate * 0.09)
full = (bytes(buf) + bytes(silence)) * 3

with wave.open("/tmp/vt_beep.wav", "wb") as w:
    w.setnchannels(1)
    w.setsampwidth(2)
    w.setframerate(sample_rate)
    w.writeframes(full)
' 2>/dev/null

# Detect all HDMI audio playback sinks/devices and broadcast the beeps across HDMI
# Try pipewire / pulseaudio / ALSA direct to HDMI cards (vc4hdmi0 / vc4hdmi1 / bcm2835_hdmi)
paplay /tmp/vt_beep.wav 2>/dev/null || true
aplay -q -D default /tmp/vt_beep.wav 2>/dev/null || true
for hdmi_dev in $(aplay -l 2>/dev/null | grep -i "hdmi" | awk '{print $2}' | tr -d ':'); do
    aplay -q -D "plughw:${hdmi_dev},0" /tmp/vt_beep.wav 2>/dev/null || true
done
for card in 0 1 2 3; do
    aplay -q -D "plughw:${card},0" /tmp/vt_beep.wav 2>/dev/null || true
    aplay -q -D "hw:${card},0" /tmp/vt_beep.wav 2>/dev/null || true
done

# Text to speech "Pi is done" across default and HDMI cards
if command -v espeak-ng >/dev/null 2>&1; then
    espeak-ng "Pi is done" --stdout 2>/dev/null > /tmp/pi_done.wav
elif command -v espeak >/dev/null 2>&1; then
    espeak "Pi is done" --stdout 2>/dev/null > /tmp/pi_done.wav
elif command -v festival >/dev/null 2>&1; then
    echo "Pi is done" | text2wave -o /tmp/pi_done.wav 2>/dev/null || true
fi

if [ -f /tmp/pi_done.wav ]; then
    paplay /tmp/pi_done.wav 2>/dev/null || true
    aplay -q -D default /tmp/pi_done.wav 2>/dev/null || true
    for hdmi_dev in $(aplay -l 2>/dev/null | grep -i "hdmi" | awk '{print $2}' | tr -d ':'); do
        aplay -q -D "plughw:${hdmi_dev},0" /tmp/pi_done.wav 2>/dev/null || true
    done
fi
