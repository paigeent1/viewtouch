#!/bin/bash
. "$(dirname "$(readlink -f "$0")")/vt-site-lib"
APK=$(ls -t "$VT_REPO"/apks/*.apk 2>/dev/null | head -n 1)
if [ -z "$APK" ]; then echo "No APK found in ~/viewtouch-main/apks/"; exit 1; fi
# First a tablet plugged into the Pi by USB (e.g. one off Wi-Fi), over the cable (before vt-adb-ensure
# switches it to Wi-Fi mode).
for u in $(adb devices | awk 'NR>1 && $2=="device" && $1 !~ /:/ {print $1}'); do
    echo -n "[USB $u - Wi-Fi $(adb -s "$u" shell ip -4 addr show wlan0 2>/dev/null | awk '/inet /{print $2}')] "
    if adb -s "$u" install -r -d "$APK" >/tmp/adb_inst.log 2>&1; then
        adb -s "$u" shell am force-stop org.viewtouch.pos >/dev/null 2>&1 || true
        adb -s "$u" shell am start -n org.viewtouch.pos/org.qtproject.qt.android.bindings.QtActivity >/dev/null 2>&1 || true
        echo "✅ PASS (over USB)"
    else
        echo "❌ FAIL ($(tr '\n' ' ' < /tmp/adb_inst.log))"
    fi
done
/usr/local/bin/vt-adb-ensure
mkdir -p "$HOME/.local/share/ViewTouch/ViewTouch/updates"
cp -f "$APK" "$HOME/.local/share/ViewTouch/ViewTouch/updates/"
echo "=== Pushing $(basename "$APK") to $(vt_tablets | cut -d'|' -f1 | paste -sd, -) ==="
while IFS='|' read -r NAME IP <&3; do
    [ -z "$IP" ] && continue
    echo -n "[$NAME - $IP] "
    adb connect "${IP}:5555" >/dev/null 2>&1 || true
    if adb -s "${IP}:5555" install -r -d "$APK" >/tmp/adb_inst.log 2>&1; then
        adb -s "${IP}:5555" shell am force-stop org.viewtouch.pos >/dev/null 2>&1 || true
        adb -s "${IP}:5555" shell am start -n org.viewtouch.pos/org.qtproject.qt.android.bindings.QtActivity >/dev/null 2>&1 || true
        VC=$(adb -s "${IP}:5555" shell dumpsys package org.viewtouch.pos | awk -F= '/versionCode/{print $2; exit}' | tr -d '\r ')
        echo "✅ PASS (Installed & Restarted -> versionCode=$VC)"
    else
        echo "❌ FAIL ($(tr '\n' ' ' < /tmp/adb_inst.log))"
    fi
done 3< <(vt_tablets)
