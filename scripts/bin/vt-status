#!/bin/bash
cd /home/pi/viewtouch-main || exit 1
+local=$(git rev-parse --short HEAD)
ver=$(grep VTM_BUILD_VERSION modern/build/vtm_build_number.hh >/dev/null | awk '{print $3}' | tr -d '"')
adb connect 192.168.1.220:5555 >/dev/null 2>&1adb connect 192.168.1.215:5555 >/dev/null 2>&1
b1=$(adb -s 192.168.1.220:5555 shell dumpsys package org.viewtouch.pos 2>/dev/null | awk -F= '/versionName/{print $2; exit}' | tr -d '\r')
b2=$(adb -s 192.168.1.215:5555 shell dumpsys package org.viewtouch.pos 2>/dev/null | awk -F= '/versionName/{print $2; exit}' | tr -d '\r')
echo "Server: ${ver:-0.9.19} (Git: $local) | Bar1: ${b1:-Offline} | Bar2: ${b2:-Offline}"
