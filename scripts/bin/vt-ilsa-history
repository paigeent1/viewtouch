#!/usr/bin/env python3
"""ILSA sales history -> ViewTouch's history database (ilsa-history.db, next to viewtouch.db), checked
day by day against ILSA's own Z reports.

  vt-ilsa-history ~/ilsa-export/"copy bhdan 10-29-2026" --dry-run --from 2026-10-28 --to 2026-10-28
  vt-ilsa-history ~/ilsa-export/"copy bhdan 10-29-2026"          import every day not in yet
  vt-ilsa-history EXPORT --from 2026-10-01 --to 2026-10-28        only those business days
  vt-ilsa-history EXPORT --replace                                days already in are imported again
  vt-ilsa-history --recheck [--dry-run] [--from/--to]              the self-check again from the history
                                                                  file (no export needed, nothing imported),
                                                                  with what explains each kind of difference
                                                                  and the days whose dates look wrong
  vt-ilsa-history EXPORT --fill-dob [--dob TABLE.COLUMN] [--dry-run]
                                                                  the buyers' birth dates into receipts already
                                                                  imported from EXPORT (found by looking at
                                                                  every column; counts printed, never dates)
  vt-ilsa-history EXPORT --prefix BHNM [--force]                  import a store's copy: BHDAN (default: Danbury)
                                                                  or BHNM (New Milford = Gaylordsville); refused
                                                                  when its Sys_Pram names another store; days are
                                                                  per store (one store never replaces another's)
  vt-ilsa-history --prefix BHDAN                                  set every copy's store (receipts: BHDAN-836100)
  vt-ilsa-history --recheck --store BHNM                          the self-check of one store's days
  vt-ilsa-history --self-test                                     check the importer on made-up data

What it does
  * Reads the CSVs vt-ilsa-export wrote (RegSale receipts, PDetail lines, TendSale tenders, RegZCnt,
    Z_Tender, Z_Taxes, Z_Totals, RegReconcile, PLU, Dept). Nothing in the export is changed.
  * Writes the history into its own SQLite file (--db, default ~/.local/share/ViewTouch/ViewTouch/
    ilsa-history.db): legacy_receipts, legacy_lines, legacy_tenders, legacy_z (+ ILSA's Z numbers),
    legacy_days, legacy_variances. ViewTouch reads it for the ILSA History reports and Receipt Lookup;
    it never loads it into memory and never counts it in today's drawers, X/Z or end of day.
  * One transaction per business day (an ILSA register Z, dated by its first receipt). Re-running skips
    the days already in (the newest day of an export is kept as "partial" and is replaced by a newer
    export); --replace imports them again. Stop it any time: the next run carries on.
  * Real runs stop ViewTouch first (it saves), back up the history file, import, and start ViewTouch
    again (vt-server) if it was running. --dry-run imports into a scratch copy and throws it away.
  * Self-check: every Z's tax and tenders rebuilt from the imported receipts against ILSA's Z_Taxes /
    Z_Tender, paid outs against RegReconcile, ILSA's Z_Totals amounts against the line totals they match
    on most days; the days that differ are printed and saved to ~/ilsa-history/variances-<when>.csv.

Rules (from vt-ilsa-tieout 1-4 and vt-ilsa-costcheck, 2026-11-04/05):
  receipts Z_MODE 0 are sales; 1 and 2 are imported but are not sales (cancelled / no sale);
  lines DETAIL_CLASS,TYPE 1,1 item sales | 1,x other dept entries (coupons, lottery redemptions) |
  15,x promotions | 16,x promotion reversals | 4,1 paid outs (not sales) | 9,x stock moves: skipped |
  anything else (30,30...) "other"; MODE_FLAGS 1/128 = a voided line pair (nets to 0), 256 = return;
  line cost = ITEM_COST x quantity (DETAIL_FOR_QTY); lines with no ITEM_COST are "no-cost" (dept 260
  open rings): ILSA counts their cost = their retail (0% margin; vt-ilsa-deptcheck 2026-11-07), so GP
  is shown as ILSA counted it and without them; promotions (15/16) are ILSA's "Buydowns" (Adjusted
  Cost = Cost + Buydowns); 1,x entries (gift cards, BH / MFG coupons) are not sales in ILSA's
  department report; departments: when sold (PDetail.DEPT), and the item's current one (PLU.DEPT_NUM)
  kept beside it for ILSA's printouts; lottery departments are history
  only, kept out of merchandise sales and GP; tax = TAXn_AMT - TAXn_REFUND_AMT; tenders = AMT_TEND
  (SALE_AMT is the whole sale repeated on each row); cash = cash AMT_TEND - all CHANGE_DUE.
Counts and dollars only are printed: never card, license or birth-date columns. The buyer's date of
birth is kept with its receipt in the history file (owner decision 2026-11-06), on this Pi only.
"""
import codecs, csv, io, os, re, shutil, sqlite3, subprocess, sys, tempfile, time
from collections import Counter, defaultdict

csv.field_size_limit(1 << 30)
SCHEMA_VERSION = 1
VT_DIR = os.path.expanduser("~/.local/share/ViewTouch/ViewTouch")
DEFAULT_DB = os.path.join(VT_DIR, "ilsa-history.db")
EXPORT = os.path.expanduser("~/ilsa-export")
OUT_DIR = os.path.expanduser("~/ilsa-history")
LOTTERY = {270, 275, 280, 300, 320, 340, 345, 360, 365, 370, 375, 377, 378, 379, 380, 400, 405, 420}
TENDER_NAMES = {1: "Cash", 10: "Check", 12: "House charge", 15: "BH Gift Card", 40: "Credit card",
                70: "Credit card", 80: "American Express", 0: "Tender 0"}
VOID_FLAGS, RETURN_FLAG = 1 | 128, 256

# The history file's tables (ViewTouch reads them: modern/app/legacy_history.cpp). One statement per
# line item, so the test fixture (modern/tests/legacy_fixture.inc) can be run a statement at a time.
SCHEMA = [
    "CREATE TABLE IF NOT EXISTS legacy_meta (key TEXT PRIMARY KEY, value TEXT)",
    "CREATE TABLE IF NOT EXISTS legacy_sources (id INTEGER PRIMARY KEY, name TEXT UNIQUE, first_day TEXT, last_day TEXT, imported_at TEXT)",
    "CREATE TABLE IF NOT EXISTS legacy_depts (dept INTEGER PRIMARY KEY, name TEXT, lottery INTEGER NOT NULL DEFAULT 0)",
    "CREATE TABLE IF NOT EXISTS legacy_z (id INTEGER PRIMARY KEY, source_id INTEGER NOT NULL, reg_num INTEGER NOT NULL, z_counter INTEGER NOT NULL, day TEXT NOT NULL, z_at TEXT, UNIQUE (source_id, reg_num, z_counter))",
    "CREATE INDEX IF NOT EXISTS legacy_z_day ON legacy_z (day)",
    # name: ilsa:tax, ilsa:tender:<type>, ilsa:payouts, ilsa:totals:<Z_Totals column> (ILSA's numbers);
    # ours:... the same rebuilt from the imported receipts at import time. Cents.
    "CREATE TABLE IF NOT EXISTS legacy_z_values (z_id INTEGER NOT NULL, name TEXT NOT NULL, cents INTEGER NOT NULL, PRIMARY KEY (z_id, name))",
    "CREATE TABLE IF NOT EXISTS legacy_receipts (id INTEGER PRIMARY KEY, source_id INTEGER NOT NULL, reg_num INTEGER NOT NULL, receipt_num INTEGER NOT NULL, z_id INTEGER, day TEXT NOT NULL, at TEXT, mode INTEGER NOT NULL DEFAULT 0, cashier INTEGER, total_cents INTEGER NOT NULL DEFAULT 0, tax_cents INTEGER NOT NULL DEFAULT 0, age_verified INTEGER NOT NULL DEFAULT 0, dob TEXT NOT NULL DEFAULT '', disc_cents INTEGER NOT NULL DEFAULT 0, UNIQUE (source_id, reg_num, receipt_num))",
    "CREATE INDEX IF NOT EXISTS legacy_receipts_day ON legacy_receipts (day)",
    "CREATE INDEX IF NOT EXISTS legacy_receipts_num ON legacy_receipts (receipt_num)",
    # kind: item | entry | promo | payout | other. mode: the receipt's (0 = a sale). qty signed (returns
    # and the voiding half of a pair are negative). unit_cost_c4: ITEM_COST in 1/10000 dollars.
    # dept: the department at the time of sale (PDetail.DEPT); cur_dept: the item's department in ILSA
    # now (PLU.DEPT_NUM: ILSA's own Department Sales report seems to use it). disc_cents: a discount
    # column of the line, if the export has one (receipts: theirs).
    "CREATE TABLE IF NOT EXISTS legacy_lines (id INTEGER PRIMARY KEY, receipt_id INTEGER NOT NULL, seq INTEGER NOT NULL, day TEXT NOT NULL, mode INTEGER NOT NULL DEFAULT 0, cls INTEGER, type INTEGER, flags INTEGER NOT NULL DEFAULT 0, kind TEXT NOT NULL, dept INTEGER, lottery INTEGER NOT NULL DEFAULT 0, upc TEXT NOT NULL DEFAULT '', name TEXT NOT NULL DEFAULT '', brand TEXT NOT NULL DEFAULT '', qty REAL NOT NULL DEFAULT 0, unit_cents INTEGER NOT NULL DEFAULT 0, amount_cents INTEGER NOT NULL DEFAULT 0, unit_cost_c4 INTEGER NOT NULL DEFAULT 0, cost_cents INTEGER NOT NULL DEFAULT 0, has_cost INTEGER NOT NULL DEFAULT 0, voided INTEGER NOT NULL DEFAULT 0, returned INTEGER NOT NULL DEFAULT 0, cur_dept INTEGER, disc_cents INTEGER NOT NULL DEFAULT 0)",
    "CREATE INDEX IF NOT EXISTS legacy_lines_day ON legacy_lines (day, kind)",
    "CREATE INDEX IF NOT EXISTS legacy_lines_receipt ON legacy_lines (receipt_id)",
    "CREATE INDEX IF NOT EXISTS legacy_lines_upc ON legacy_lines (upc)",
    "CREATE TABLE IF NOT EXISTS legacy_tenders (id INTEGER PRIMARY KEY, receipt_id INTEGER NOT NULL, seq INTEGER NOT NULL, type INTEGER NOT NULL, name TEXT NOT NULL, amount_cents INTEGER NOT NULL DEFAULT 0, change_cents INTEGER NOT NULL DEFAULT 0, sale_cents INTEGER NOT NULL DEFAULT 0)",
    "CREATE INDEX IF NOT EXISTS legacy_tenders_receipt ON legacy_tenders (receipt_id)",
    # One copy per store and day: another store's day never replaces or skips this one.
    "CREATE TABLE IF NOT EXISTS legacy_days (store TEXT NOT NULL DEFAULT 'BHDAN', day TEXT NOT NULL, source_id INTEGER NOT NULL, partial INTEGER NOT NULL DEFAULT 0, receipts INTEGER NOT NULL DEFAULT 0, variances INTEGER NOT NULL DEFAULT 0, imported_at TEXT, PRIMARY KEY (store, day))",
    "CREATE TABLE IF NOT EXISTS legacy_variances (id INTEGER PRIMARY KEY, day TEXT NOT NULL, z_id INTEGER, what TEXT NOT NULL, ilsa_cents INTEGER NOT NULL, ours_cents INTEGER NOT NULL)",
    "CREATE INDEX IF NOT EXISTS legacy_variances_day ON legacy_variances (day)",
    # Each imported copy's item list (PLU): names for lines whose item a later copy no longer has.
    # bare: the UPC without leading zeros (ILSA kept codes as numbers).
    "CREATE TABLE IF NOT EXISTS legacy_items (source_id INTEGER NOT NULL, upc TEXT NOT NULL, bare TEXT NOT NULL, name TEXT NOT NULL, brand TEXT NOT NULL DEFAULT '', dept INTEGER, PRIMARY KEY (source_id, upc))",
    "CREATE INDEX IF NOT EXISTS legacy_items_bare ON legacy_items (bare)",
    # Each copy's cashiers (number and name only: never PINs, pay or anything else of theirs).
    "CREATE TABLE IF NOT EXISTS legacy_cashiers (source_id INTEGER NOT NULL, cashier_num INTEGER NOT NULL, name TEXT NOT NULL, PRIMARY KEY (source_id, cashier_num))",
    # Which ViewTouch employee an ILSA cashier is (set on Reports > ILSA History > Cashiers; the
    # importer never changes it). No row: a former employee.
    "CREATE TABLE IF NOT EXISTS legacy_cashier_map (source_id INTEGER NOT NULL, cashier_num INTEGER NOT NULL, employee_id TEXT NOT NULL, employee_name TEXT NOT NULL DEFAULT '', PRIMARY KEY (source_id, cashier_num))",
]
# Columns added after the first version (an older history file gets them when opened).
