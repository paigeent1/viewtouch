               "legacy_lines", "legacy_tenders", "legacy_days", "legacy_variances"]


# --- reading the export ------------------------------------------------------------------------------

def _cp1252(err):
    """Bytes that aren't UTF-8 are read as Windows-1252 (the ILSA computer's character set)."""
    return err.object[err.start:err.end].decode("cp1252", errors="replace"), err.end
codecs.register_error("vt_cp1252", _cp1252)


def table_path(d, t):
    for f in os.listdir(d):
        if f.lower() == (t + ".csv").lower():
            return os.path.join(d, f)
    return None


def rows(d, t):
    """(header -> index map, row lists) of one table; nothing if it isn't in the export."""
    p = table_path(d, t)
    if not p:
        return {}, iter(())
    fh = open(p, "rb")
    text = io.TextIOWrapper(fh, encoding="utf-8-sig", errors="vt_cp1252", newline="")
    reader = csv.reader(text)
    header = next(reader, [])
    return {h.strip().upper(): i for i, h in enumerate(header)}, reader


class Row:
    """A CSV row read by column name (any case)."""
    __slots__ = ("h", "r")
    def __init__(self, h): self.h, self.r = h, []
    def __call__(self, *names):
        for n in names:
            i = self.h.get(n)
            if i is not None and i < len(self.r):
                return self.r[i]
        return ""


def num(s):
    try:
        return float((s or "").replace("$", "").replace(",", "").strip() or 0)
    except ValueError:
        return 0.0


def cents(s):
    return int(round(num(s) * 100))


def code(s):
    s = (s or "").strip()
    return s[:-2] if s.endswith(".0") and s[:-2].lstrip("-").isdigit() else s


def integer(s, default=0):
    try:
        return int(float(code(s) or default))
    except ValueError:
        return default


US = re.compile(r"^(\d{1,2})/(\d{1,2})/(\d{2,4})(?:\s+(\d{1,2}):(\d{2})(?::(\d{2}))?\s*([AaPp][Mm])?)?")
def iso(s):
    """2024-01-02 10:00:00, 01/02/24 10:00:00 or 1/2/2024 10:00 AM -> '2024-01-02 10:00:00' ('' if none)."""
    s = (s or "").strip()
    if len(s) >= 10 and s[:4].isdigit() and s[4] == "-":
        return (s[:19] + " 00:00:00"[len(s[:19]) - 10:]) if len(s) < 19 else s[:19]
    m = US.match(s)
    if not m:
        return ""
    mo, d, y, hh, mi, ss, ap = m.groups()
    y = int(y); y += 2000 if y < 70 else (1900 if y < 100 else 0)
    h = int(hh or 0)
    if ap:
        h = h % 12 + (12 if ap.lower() == "pm" else 0)
    return f"{y:04d}-{int(mo):02d}-{int(d):02d} {h:02d}:{int(mi or 0):02d}:{int(ss or 0):02d}"


def dob_date(s, sale_year):
    """A birth date as YYYY-MM-DD (a 2-digit year is in the past century when it'd be after the sale)."""
    s = (s or "").strip()
    if not s or s in ("0", "0.0"):
        return ""
    m = US.match(s)
    if m:
        mo, d, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if y < 100:
            y += 2000 if 2000 + y <= sale_year else 1900
        return f"{y:04d}-{mo:02d}-{d:02d}"
    if len(s) >= 10 and s[:4].isdigit() and s[4] == "-":
        return s[:10]
    if re.fullmatch(r"\d{8}", s):   # YYYYMMDD
        return f"{s[:4]}-{s[4:6]}-{s[6:]}"
    return ""


# --- the buyer's date of birth: where the export keeps it -----------------------------------------------

def find_dob_columns(export, sample=200000):
    """Columns that hold birth dates, in any table: most of their values read as dates with years from
    1900 to 2010, spread over 10 years or more and starting before 1990 (sale and Z times are later or
    close together). Returns [(score, table, column, keyed, n, year_from,
    year_to)], the likeliest first; keyed: the table has RECEIPT_NUM (and maybe REG_NUM). Counts and
    years only: no date is printed or kept here."""
    out = []
    for f in sorted(os.listdir(export)):
        if not f.lower().endswith(".csv"):
            continue
        table = f[:-4]
        h, it = rows(export, table)
        if not h:
            continue
        cols = list(h)
        named = [c for c in cols if re.search(r"DOB|BIRTH|BDAY|AGE_DATE|DL_DATE|ID_DATE", c)]
        seen = defaultdict(lambda: [0, 0, 9999, 0])   # column -> [dates, birth-like, min year, max year]
        r = Row(h)
        for i, r.r in enumerate(it):
            if i >= sample:
                break
            for c in cols:
                v = r(c).strip()
                if len(v) < 6 or not v[:1].isdigit():
                    continue
                d = dob_date(v, 2030)
                if not d or not d[:4].isdigit():
                    continue
                y = int(d[:4]); t = seen[c]
                t[0] += 1
                if 1900 <= y <= 2010:
                    t[1] += 1; t[2] = min(t[2], y); t[3] = max(t[3], y)
        keyed = "RECEIPT_NUM" in h
        for c, (n, birth, y0, y1) in seen.items():
            # Buyers' birth years spread over decades and start well before any sale (a 2006-2008 copy's
            # sale times are years 1900-2010 too, but all close together).
            if birth >= 20 and birth >= 0.8 * n and y0 < 1990 and y1 - y0 >= 10:
                score = (c in named, keyed, birth)
                out.append((score, table, c, keyed, birth, y0, y1))
    out.sort(key=lambda x: x[0], reverse=True)
    return out


def fill_dob(db, export, source_id, say, column=None, dry=False):
    """Fills legacy_receipts.dob (where empty) for this copy's receipts from the export's birth-date
    column (`column` "TABLE.COLUMN", else the likeliest keyed one). Returns how many were filled."""
    found = find_dob_columns(export)
    for score, table, c, keyed, n, y0, y1 in found[:6]:
        say(f"  birth dates? {table}.{c}: {n:,} values read as dates from {y0} to {y1}"
            + ("" if keyed else " (no RECEIPT_NUM: can't be tied to a receipt)"))
    if column:
        table, _, c = column.partition(".")
        pick = next(((t, cc) for _, t, cc, k, *_ in found if t.lower() == table.lower() and cc == c.upper() and k), None)
        if not pick:
            say(f"  {column}: not a column of birth dates keyed by RECEIPT_NUM in this export")
            return 0
    else:
        pick = next(((t, cc) for _, t, cc, k, *_ in found if k), None)
        if not pick:
            say("  birth dates: none found in this export (receipts keep only the age checked)")
            return 0
    table, c = pick
    h, it = rows(export, table); r = Row(h)
    years = {(a, b): y for a, b, y in db.execute("SELECT reg_num, receipt_num, CAST(substr(at, 1, 4) AS INTEGER) FROM legacy_receipts "
                                                  "WHERE source_id = ? AND dob = ''", (source_id,))}
    regs = defaultdict(set)
    for a, b in years:
        regs[b].add(a)
    batch = []
    for r.r in it:
        num = integer(r("RECEIPT_NUM"), -1)
        reg = integer(r("REG_NUM"), -1) if "REG_NUM" in h else (next(iter(regs[num])) if len(regs.get(num, ())) == 1 else -1)
        if (reg, num) not in years:
            continue
        d = dob_date(r(c), years[(reg, num)] or 9999)
        if d:
            batch.append((d, source_id, reg, num))
    if not dry:
        db.executemany("UPDATE legacy_receipts SET dob = ? WHERE source_id = ? AND reg_num = ? AND receipt_num = ? AND dob = ''", batch)
        db.commit()
    say(f"  birth dates from {table}.{c}: {len(batch):,} receipt(s) " + ("would get theirs (dry run)" if dry else "filled"))
    return len(batch)


def fill_dob_command(export, db_path, column, dry, out_dir):
    if not os.path.exists(db_path):
        sys.exit(f"No history file at {db_path}: import first.")
    source = os.path.basename(os.path.normpath(export))
    db = open_db(db_path)
    row = db.execute("SELECT id FROM legacy_sources WHERE name = ?", (source,)).fetchone()
    if not row:
        sys.exit(f"{source} hasn't been imported into {db_path}.")
    if not dry:
        stamp = time.strftime("%Y-%m-%d_%H%M%S")
        os.makedirs(os.path.join(out_dir, "backups"), exist_ok=True)
        backup = os.path.join(out_dir, "backups", f"ilsa-history-before-dob-{stamp}.db")
        dst = sqlite3.connect(backup); db.backup(dst); dst.close()
        print(f"Backup: {backup}")
    print(("DRY RUN: " if dry else "") + f"birth dates for {source}'s receipts")
    n = fill_dob(db, export, row[0], print, column, dry)
    close_db(db)
    return n


def kind_of(cls, typ):
    if cls == 1:
        return "item" if typ == 1 else "entry"
    if cls in (15, 16):
        return "promo"
    if cls == 4:
        return "payout"
    if cls == 9:
        return None          # stock moves, never on a receipt
    return "other"


# --- the history file --------------------------------------------------------------------------------

def open_db(path):
    db = sqlite3.connect(path)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=NORMAL")
    db.execute("PRAGMA temp_store=FILE")
    for s in SCHEMA:
        db.execute(s)
    for table, col, decl in ADDED_COLUMNS:
        if col not in [c[1] for c in db.execute(f"PRAGMA table_info({table})")]:
            db.execute(f"ALTER TABLE {table} ADD COLUMN {col} {decl}")
    if "store" not in [c[1] for c in db.execute("PRAGMA table_info(legacy_days)")]:   # days were one for all stores
        db.execute("ALTER TABLE legacy_days RENAME TO legacy_days_old")
        db.execute([x for x in SCHEMA if "TABLE IF NOT EXISTS legacy_days " in x][0])
        db.execute("""INSERT INTO legacy_days (store, day, source_id, partial, receipts, variances, imported_at)
                      SELECT COALESCE((SELECT store FROM legacy_sources s WHERE s.id = o.source_id), 'BHDAN'), o.day, o.source_id,
                             o.partial, o.receipts, o.variances, o.imported_at FROM legacy_days_old o""")
        db.execute("DROP TABLE legacy_days_old")
    for s in LATE_SCHEMA:
        db.execute(s)
    db.execute("INSERT OR REPLACE INTO legacy_meta VALUES ('schema_version', ?)", (str(SCHEMA_VERSION),))
    db.commit()
    return db


def close_db(db):
    """Back to a plain rollback journal, so ViewTouch can open the file read-only."""
    db.commit()
    db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    db.execute("PRAGMA journal_mode=DELETE")
    db.close()


STAGE = [
    "CREATE TEMP TABLE sz (reg INTEGER, z INTEGER, z_at TEXT, day TEXT, PRIMARY KEY (reg, z))",
    "CREATE TEMP TABLE sr (reg INTEGER, num INTEGER, z INTEGER, at TEXT, mode INTEGER, cashier INTEGER, total INTEGER, tax INTEGER, age INTEGER, dob TEXT, disc INTEGER, PRIMARY KEY (reg, num))",
    "CREATE TEMP TABLE sl (reg INTEGER, num INTEGER, seq INTEGER, cls INTEGER, type INTEGER, flags INTEGER, kind TEXT, dept INTEGER, lottery INTEGER, upc TEXT, name TEXT, brand TEXT, qty REAL, unit INTEGER, amount INTEGER, cost4 INTEGER, cost INTEGER, has_cost INTEGER, voided INTEGER, returned INTEGER, cur_dept INTEGER, disc INTEGER, name_src TEXT)",
    "CREATE TEMP TABLE st (reg INTEGER, num INTEGER, seq INTEGER, type INTEGER, name TEXT, amount INTEGER, change INTEGER, sale INTEGER)",
    "CREATE TEMP TABLE sv (reg INTEGER, z INTEGER, name TEXT, cents INTEGER, PRIMARY KEY (reg, z, name))",
]


def z_rows(export, table):
    """A Z table's rows for the whole register: cashier 0 / blank and mode 0 / blank when the table has
    such rows (else every row: ILSA kept only one kind), as vt-ilsa-tieout did."""
    h, it = rows(export, table)
    r = Row(h)
    every = []
    for r.r in it:
        every.append(list(r.r))
    def level(row):
        r.r = row
        return ("CSHR_NUM" not in h or code(r("CSHR_NUM")) in ("", "0")) and ("Z_MODE" not in h or code(r("Z_MODE")) in ("", "0"))
    reg = [x for x in every if level(x)]
    for x in (reg or every):
        r.r = x
        yield h, r


NUMBER_COLS = ("CSHR_NUM", "CASHIER_NUM", "CSHR_ID", "EMP_NUM", "EMPLOYEE_NUM", "EMP_ID", "CLERK_NUM")
# Columns never read from a cashier table (only the number and the name are kept).
PRIVATE = re.compile(r"PIN|PASS|PWD|SSN|SOC|PAY|RATE|WAGE|SALARY|ADDR|PHONE|DOB|BIRTH|SECUR|CARD|LICEN|EMAIL|ZIP|CITY", re.I)


def cashier_table(export):
    """(table, number column, name columns) of the export's cashier list, or None: a table with a cashier
    number column and a name column (CSHR_NAME, NAME... or FIRST + LAST), its name saying cashier /
    employee / clerk when several have both. Tables of totals by cashier (Z_...) have no name column."""
    found = []
    for f in sorted(os.listdir(export)):
        if not f.lower().endswith(".csv"):
            continue
        with open(os.path.join(export, f), "rb") as fh:
            head = fh.readline().decode("utf-8-sig", errors="replace")
        cols = [c.strip().upper() for c in next(csv.reader([head]), [])]
        num = next((c for c in NUMBER_COLS if c in cols), None)
        names = [c for c in cols if re.search(r"NAME|FIRST|LAST", c) and not PRIVATE.search(c) and c != num
                 and not re.search(r"LOGIN|USER|FILE|TENDER|DEPT|STORE|REG", c)]
        if not num or not names:
            continue
        whole = next((c for c in names if c in ("CSHR_NAME", "CASHIER_NAME", "EMP_NAME", "EMPLOYEE_NAME", "NAME", "FULL_NAME")), None)
        first = next((c for c in names if "FIRST" in c), None)
        last = next((c for c in names if "LAST" in c and "LAST_" not in c.replace("LAST_NAME", "")), None)
        use = [whole] if whole else [c for c in (first, last) if c] or names[:1]
        score = (bool(re.search(r"CSHR|CASH|EMP|CLERK|STAFF", f, re.I)), bool(whole or first))
        found.append((score, f[:-4], num, use))
    if not found:
        return None
    found.sort(key=lambda x: x[0], reverse=True)
    return found[0][1:]


def stage(db, export, day_from, day_to, done, say, source_id=0):
    """The export into temp tables; returns the business days to import (ordered)."""
    for s in STAGE:
        db.execute(s)
    # Z's and receipts.
    h, it = rows(export, "RegZCnt"); r = Row(h); zs = []
    for r.r in it:
        zs.append((integer(r("REG_NUM")), integer(r("REG_Z_COUNTER")), iso(r("REG_Z_DATETIME"))))
    db.executemany("INSERT OR IGNORE INTO sz (reg, z, z_at) VALUES (?, ?, ?)", zs)
    h, it = rows(export, "RegSale"); r = Row(h)
    if not h:
        sys.exit(f"RegSale.csv isn't in {export}")
    dob_col = next((c for c in h if re.search(r"DOB|BIRTH", c)), None)
    age_col = next((c for c in h if "AGE_VER" in c), None)
    disc_cols = [c for c in h if "DISC" in c and ("AMT" in c or c.endswith("DISC"))]
    if disc_cols:
        say("  receipt discount columns: " + ", ".join(disc_cols))
    batch, n = [], 0
    for r.r in it:
        at = iso(r("START_TIME", "END_TIME", "DATE_TIME"))
        tax = sum(cents(r(f"TAX{i}_AMT")) - cents(r(f"TAX{i}_REFUND_AMT")) for i in range(1, 9))
        batch.append((integer(r("REG_NUM")), integer(r("RECEIPT_NUM")), integer(r("REG_Z_COUNTER")), at,
                      integer(r("Z_MODE")), integer(r("CSHR_NUM")), cents(r("SALE_TOTAL")), tax,
                      integer(r(age_col)) if age_col else 0,
                      dob_date(r(dob_col), int(at[:4] or 0) or 9999) if dob_col else "",
                      sum(cents(r(c)) for c in disc_cols)))
        if len(batch) >= 20000:
            db.executemany("INSERT OR IGNORE INTO sr VALUES (?,?,?,?,?,?,?,?,?,?,?)", batch); n += len(batch); batch = []
    db.executemany("INSERT OR IGNORE INTO sr VALUES (?,?,?,?,?,?,?,?,?,?,?)", batch); n += len(batch)
    say(f"  receipts in the export: {n:,}" + ("" if dob_col else "  (no birth-date column found)"))
    db.execute("CREATE INDEX sr_z ON sr (reg, z)")
    db.execute("INSERT OR IGNORE INTO sz (reg, z) SELECT DISTINCT reg, z FROM sr")
    # A Z's business day: the date of its first receipt (a Z run after midnight still belongs to the
    # day it closed); a Z with no receipts: the date it was run.
    db.execute("UPDATE sz SET day = COALESCE((SELECT substr(MIN(at), 1, 10) FROM sr WHERE sr.reg = sz.reg AND sr.z = sz.z AND at <> ''), substr(z_at, 1, 10))")
    db.execute("DELETE FROM sz WHERE day IS NULL OR day = ''")
    last = db.execute("SELECT MAX(day) FROM sz").fetchone()[0]
    days = [d for (d,) in db.execute("SELECT DISTINCT day FROM sz ORDER BY day")
            if (not day_from or d >= day_from) and (not day_to or d <= day_to) and d not in done]
    day_set = set(days)
    wanted_z = {(a, b) for (a, b, d) in db.execute("SELECT reg, z, day FROM sz") if d in day_set}
    keep = {(a, b) for (a, b, z) in db.execute("SELECT reg, num, z FROM sr") if (a, z) in wanted_z}
    db.execute("CREATE TEMP TABLE wz (reg INTEGER, z INTEGER, PRIMARY KEY (reg, z))")
    db.executemany("INSERT INTO wz VALUES (?, ?)", wanted_z)
    db.execute("DELETE FROM sr WHERE NOT EXISTS (SELECT 1 FROM wz WHERE wz.reg = sr.reg AND wz.z = sr.z)")
    db.execute("DELETE FROM sz WHERE NOT EXISTS (SELECT 1 FROM wz WHERE wz.reg = sz.reg AND wz.z = sz.z)")
    db.execute("CREATE INDEX sz_day ON sz (day)")

    # Names: this copy's items (kept in the history file for the other copies' lines too) and
    # departments (the newest copy's names win); promotions by their id.
    h, it = rows(export, "PLU"); r = Row(h); item = {}
    for r.r in it:
        u = code(r("PLU_NUM"))
        if u:
            item[u] = ((r("PLU_DESC") or r("POS_DESC")).strip(), r("MANUF").strip().upper(), integer(r("DEPT_NUM"), -1))
    db.execute("DELETE FROM legacy_items WHERE source_id = ?", (source_id,))
    db.executemany("INSERT OR REPLACE INTO legacy_items VALUES (?, ?, ?, ?, ?, ?)",
                   [(source_id, u, u.lstrip("0") or u, n, b, d) for u, (n, b, d) in item.items() if n])
    h, it = rows(export, "Dept"); r = Row(h); dept_name = {}
    for r.r in it:
        d = integer(r("DEPT_NUM"), -1)
        if d >= 0:
            dept_name[d] = (r("DEPT_NAME") or r("POS_DESC")).strip()
    newest = db.execute("SELECT MAX(last_day) FROM legacy_sources WHERE id <> ?", (source_id,)).fetchone()[0]
    db.executemany("INSERT OR REPLACE INTO legacy_depts VALUES (?, ?, ?)" if not newest or (last or "") >= newest
                   else "INSERT OR IGNORE INTO legacy_depts VALUES (?, ?, ?)",
                   [(d, n, int(d in LOTTERY)) for d, n in dept_name.items()])
    # Cashiers: number and name only.
    ct = cashier_table(export)
    if ct:
        table, numcol, namecols = ct
        h, it = rows(export, table); r = Row(h); cashiers = {}
        for r.r in it:
            n = integer(r(numcol), -1)
            name = " ".join(r(c).strip() for c in namecols if r(c).strip())
            if n >= 0 and name:
                cashiers[n] = name
        db.execute("DELETE FROM legacy_cashiers WHERE source_id = ?", (source_id,))
        db.executemany("INSERT INTO legacy_cashiers VALUES (?, ?, ?)", [(source_id, n, nm) for n, nm in cashiers.items()])
        say(f"  cashiers: {len(cashiers)} from {table} ({numcol}, {' + '.join(namecols)}): "
            + ", ".join(f"{n} {nm}" for n, nm in sorted(cashiers.items())))
    else:
        say("  cashiers: no table with a cashier number and a name in this export (receipts keep the number)")
    if not days:
        return days, last
    promo = {}
    for t in ("PRC_ADJ", "PRC_ADJ_ARCHIVE", "SYSDISCOUNT", "SYSDISCOUNT_ARCHIVE"):
        h, it = rows(export, t); r = Row(h)
        for r.r in it:
            name = (r("PRC_NAME", "DISC_NAME", "DESCRIPTION", "NAME")).strip()
            if name:
                promo.setdefault(integer(r("ID"), -1), name)

    # Lines of the receipts to import.
    h, it = rows(export, "PDetail"); r = Row(h)
    desc_col = next((c for c in ("DETAIL_DESC", "PLU_DESC", "DESCRIPTION") if c in h), None)
    line_disc = [c for c in h if "DISC" in c and ("AMT" in c or c.endswith("DISC"))]
    if line_disc:
        say("  line discount columns: " + ", ".join(line_disc))
    batch, n, seq = [], 0, 0
    for r.r in it:
        seq += 1
        key = (integer(r("REG_NUM")), integer(r("RECEIPT_NUM")))
        if key not in keep:
            continue
        cls, typ = integer(r("DETAIL_CLASS")), integer(r("DETAIL_TYPE"))
        kind = kind_of(cls, typ)
        if kind is None:
            continue
        flags = integer(r("MODE_FLAGS"))
        dept = integer(r("DEPT", "DEPT_NUM"), 0)
        upc = code(r("PLU", "PLU_NUM"))
        amount = cents(r("DETAIL_LINE_AMT"))
        unit = cents(r("DETAIL_ITEM_PRC"))
        q = abs(num(r("DETAIL_FOR_QTY")))
        if q == 0:
            q = round(abs(amount / unit), 3) if unit else 1.0
        qty = -q if amount < 0 else q
        cost4 = int(round(num(r("ITEM_COST")) * 10000))
        cost = int(round(cost4 * qty / 100)) if kind == "item" else 0
        name, brand, cur = item.get(upc, ("", "", -1))
        if desc_col and r(desc_col).strip():
            name = r(desc_col).strip()
        src = "export"
        if kind == "promo":
            name = ("Promotion reversed" if cls == 16 else "Promotion") + (f": {promo[typ]}" if typ in promo else "")
            src = "fixed"
        elif kind == "payout":
            name, src = "Paid out", "fixed"
        elif not name:   # an item this copy no longer has: another copy's list may (name_backfill)
            name, src = dept_name.get(dept) or f"Dept {dept}", "dept"
        batch.append((key[0], key[1], seq, cls, typ, flags, kind, dept, int(dept in LOTTERY), upc, name, brand,
                      qty, unit, amount, cost4, cost, int(cost4 != 0), int(bool(flags & VOID_FLAGS)),
                      int(bool(flags & RETURN_FLAG)), cur if cur >= 0 else dept, sum(cents(r(c)) for c in line_disc), src))
        if len(batch) >= 20000:
            db.executemany(f"INSERT INTO sl VALUES ({','.join('?' * 23)})", batch); n += len(batch); batch = []
    db.executemany(f"INSERT INTO sl VALUES ({','.join('?' * 23)})", batch); n += len(batch)
    say(f"  lines to import: {n:,}")
    db.execute("CREATE INDEX sl_key ON sl (reg, num)")

    h, it = rows(export, "TendSale"); r = Row(h)
    batch, seq = [], 0
    for r.r in it:
        seq += 1
        key = (integer(r("REG_NUM")), integer(r("RECEIPT_NUM")))
        if key not in keep:
            continue
        ty = integer(r("TENDER_TYPE"))
        batch.append((key[0], key[1], seq, ty, TENDER_NAMES.get(ty, f"Tender {ty}"), cents(r("AMT_TEND")),
                      cents(r("CHANGE_DUE")), cents(r("SALE_AMT"))))
    db.executemany("INSERT INTO st VALUES (?,?,?,?,?,?,?,?)", batch)
    db.execute("CREATE INDEX st_key ON st (reg, num)")

    # ILSA's own Z numbers.
    vals = defaultdict(int)
    h, it = rows(export, "Z_Tender"); r = Row(h)
    for r.r in it:
        z = (integer(r("REG_NUM")), integer(r("REG_Z_COUNTER")))
        if z in wanted_z:
            vals[(z, f"ilsa:tender:{integer(r('TENDER_TYPE'))}")] += cents(r("TENDER_AMT"))
    for h, r in z_rows(export, "Z_Taxes"):
        z = (integer(r("REG_NUM")), integer(r("REG_Z_COUNTER")))
        if z in wanted_z:
            vals[(z, "ilsa:tax")] += sum(cents(r(f"TAX{i}_AMT")) - cents(r(f"TAX{i}_REFUND_AMT")) for i in range(1, 9))
    for h, r in z_rows(export, "Z_Totals"):
        z = (integer(r("REG_NUM")), integer(r("REG_Z_COUNTER")))
        if z in wanted_z:
            for c in h:
                if c.endswith("_AMT"):
                    vals[(z, f"ilsa:totals:{c}")] += cents(r(c))
    h, it = rows(export, "RegReconcile"); r = Row(h)
    for r.r in it:
        z = (integer(r("REG_NUM")), integer(r("REG_Z_COUNTER")))
        if z in wanted_z and "Z_PAYOUTS" in h:
            vals[(z, "ilsa:payouts")] += cents(r("Z_PAYOUTS"))
    db.executemany("INSERT INTO sv VALUES (?, ?, ?, ?)", [(z[0], z[1], name, c) for (z, name), c in vals.items()])
    return days, last


# What the imported receipts of one Z add up to (the same rules ViewTouch's reports use).
OURS_SQL = """
SELECT r.z_id,
  SUM(CASE WHEN r.mode = 0 THEN r.tax_cents ELSE 0 END),
  SUM(CASE WHEN r.mode = 0 THEN r.total_cents ELSE 0 END),
  SUM(CASE WHEN r.mode = 0 THEN 1 ELSE 0 END),
  SUM(CASE WHEN r.mode = 0 THEN r.disc_cents ELSE 0 END)
FROM legacy_receipts r WHERE r.day = ? GROUP BY r.z_id"""
LINES_SQL = """
SELECT r.z_id, l.kind, l.lottery, SUM(CASE WHEN r.mode = 0 OR l.kind = 'payout' THEN l.amount_cents ELSE 0 END)
FROM legacy_lines l JOIN legacy_receipts r ON r.id = l.receipt_id WHERE l.day = ? GROUP BY r.z_id, l.kind, l.lottery"""
TENDERS_SQL = """
SELECT r.z_id, t.type, SUM(t.amount_cents), SUM(t.change_cents)
FROM legacy_tenders t JOIN legacy_receipts r ON r.id = t.receipt_id WHERE r.day = ? GROUP BY r.z_id, t.type"""
# Each sales receipt: its total, tax, receipt discount and what its lines add up to.
RECEIPT_SUMS_SQL = """
SELECT r.z_id, r.total_cents, r.tax_cents, r.disc_cents,
  (SELECT COALESCE(SUM(amount_cents), 0) FROM legacy_lines l WHERE l.receipt_id = r.id)
FROM legacy_receipts r WHERE r.day = ? AND r.mode = 0"""
RECEIPT_STATS = Counter()     # how each receipt's total was explained (printed by --recheck)
RECEIPT_DIFFS = Counter()     # the unexplained differences (total - lines - tax), cents


def receipt_explained(total, tax, disc, lines):
    """Whether a receipt's total is its lines + tax, less (or plus) its receipt discount, to the cent."""
    base = total - lines - tax
    if abs(base) <= 1:
        RECEIPT_STATS["lines + tax"] += 1
        return True
    if disc and abs(base + disc) <= 1:
        RECEIPT_STATS["lines + tax - receipt discount"] += 1
        return True
    if disc and abs(base - disc) <= 1:
        RECEIPT_STATS["lines + tax + receipt discount (sign kept the other way)"] += 1
        return True
    RECEIPT_STATS["unexplained"] += 1
    RECEIPT_DIFFS[base] += 1
    return False


def ours_for_day(db, day):
    """z_id -> {name: cents} rebuilt from the imported rows of `day`."""
    out = defaultdict(lambda: defaultdict(int))
    for z, tax, total, n, disc in db.execute(OURS_SQL, (day,)):
        o = out[z]; o["ours:tax"] += tax or 0; o["ours:sale_totals"] += total or 0; o["ours:receipts"] += n or 0
        o["ours:discounts"] += disc or 0
    for z, kind, lottery, amt in db.execute(LINES_SQL, (day,)):
        o = out[z]; amt = amt or 0
        if kind == "payout":
            o["ours:payouts"] += amt; continue
        o["ours:net"] += amt
        o[f"ours:{kind}s"] += amt
        o["ours:lottery" if lottery else "ours:merchandise"] += amt if kind == "item" else 0
    change = defaultdict(int)
    for z, ty, amt, ch in db.execute(TENDERS_SQL, (day,)):
        out[z][f"ours:tender:{ty}"] += amt or 0
        change[z] += ch or 0
    for z, ch in change.items():   # all change given comes out of cash (also on card / gift overtenders)
        out[z]["ours:tender:1"] = out[z].get("ours:tender:1", 0) - ch
    for z, total, tax, disc, lines in db.execute(RECEIPT_SUMS_SQL, (day,)):
        if not receipt_explained(total, tax, disc or 0, lines):
            out[z]["ours:receipts_off"] += 1
    for o in out.values():
        o["ours:gross"] = o.get("ours:net", 0) + o.get("ours:tax", 0)
    return out


# Differences known and left as ILSA recorded them (owner): (day, Z, what it starts with) -> why.
KNOWN = {
    ("2023-02-02", 5828, "Tender Cash"): "known: a mistyped tender amount in ILSA, left as recorded",
}
NO_SAVED_TENDERS = Counter()   # Z's whose ILSA Z kept no tenders at all: not compared (printed by --recheck)


def check_day(db, day):
    """ILSA's own Z against the imported receipts, for one business day (inside the caller's
    transaction): our totals rebuilt and kept (ours:...), the day's differences rewritten (the Z_Totals
    ones are learn_z_totals'). Returns the differences."""
    ours = ours_for_day(db, day)
    zs = db.execute("SELECT id, z_counter FROM legacy_z WHERE day = ?", (day,)).fetchall()
    db.execute("DELETE FROM legacy_z_values WHERE name LIKE 'ours:%' AND z_id IN (SELECT id FROM legacy_z WHERE day = ?)", (day,))
    db.executemany("INSERT OR REPLACE INTO legacy_z_values VALUES (?, ?, ?)",
                   [(z, k, v) for z, o in ours.items() for k, v in o.items()])
    db.execute("DELETE FROM legacy_variances WHERE day = ? AND what NOT LIKE 'Z_Totals %'", (day,))
    var = []
    for zid, zc in zs:
        ilsa = dict(db.execute("SELECT name, cents FROM legacy_z_values WHERE z_id = ? AND name LIKE 'ilsa:%'", (zid,)).fetchall())
        o = ours.get(zid, {})
        checks = [("Tax", ilsa.get("ilsa:tax"), o.get("ours:tax", 0))]
        # Tenders only when ILSA's Z kept some: a Z with none saved can't be compared (counted apart).
        if any(k.startswith("ilsa:tender:") for k in ilsa):
            types = {int(k.rsplit(":", 1)[1]) for k in list(ilsa) + list(o) if k.startswith(("ilsa:tender:", "ours:tender:"))}
            for ty in sorted(types):
                checks.append((f"Tender {TENDER_NAMES.get(ty, ty)} ({ty})", ilsa.get(f"ilsa:tender:{ty}", 0), o.get(f"ours:tender:{ty}", 0)))
        elif any(k.startswith("ours:tender:") and v for k, v in o.items()):
            NO_SAVED_TENDERS[day[:4]] += 1
        if "ilsa:payouts" in ilsa and abs(ilsa["ilsa:payouts"]) != abs(o.get("ours:payouts", 0)):
            var.append((day, zid, "Paid outs", ilsa["ilsa:payouts"], o.get("ours:payouts", 0)))
        for what, a, b in checks:
            if a is not None and abs(a - b) > 1:
                var.append((day, zid, what, a, b))
        if o.get("ours:receipts_off"):
            var.append((day, zid, "Receipts whose lines + tax (less their discount) differ from their total (count)", 0, o["ours:receipts_off"]))
        for i, (d, z, what, a, b) in enumerate(var):
            for (kd, kz, kw), why in KNOWN.items():
                if z == zid and d == kd and zc == kz and what.startswith(kw) and "known:" not in what:
                    var[i] = (d, z, f"{what} ({why})", a, b)
    db.executemany("INSERT INTO legacy_variances (day, z_id, what, ilsa_cents, ours_cents) VALUES (?, ?, ?, ?, ?)", var)
    db.execute("""UPDATE legacy_days SET variances = (SELECT COUNT(*) FROM legacy_variances v JOIN legacy_z z ON z.id = v.z_id
                       JOIN legacy_sources s ON s.id = z.source_id WHERE v.day = legacy_days.day AND s.store = legacy_days.store) WHERE day = ?""", (day,))
    return var


def import_day(db, source_id, store, day, partial, replace_old, now):
    """One business day, in one transaction. Returns (receipts, variances)."""
    db.execute("BEGIN")
    try:
        if replace_old:   # this store's copy of the day (another store's stays)
            mine = "SELECT id FROM legacy_sources WHERE store = ?"
            rec = f"SELECT id FROM legacy_receipts WHERE day = ? AND source_id IN ({mine})"
            zs = f"SELECT id FROM legacy_z WHERE day = ? AND source_id IN ({mine})"
            db.execute(f"DELETE FROM legacy_lines WHERE receipt_id IN ({rec})", (day, store))
            db.execute(f"DELETE FROM legacy_tenders WHERE receipt_id IN ({rec})", (day, store))
            db.execute(f"DELETE FROM legacy_receipts WHERE id IN ({rec})", (day, store))
            db.execute(f"DELETE FROM legacy_z_values WHERE z_id IN ({zs})", (day, store))
            db.execute(f"DELETE FROM legacy_variances WHERE z_id IN ({zs})", (day, store))
            db.execute(f"DELETE FROM legacy_z WHERE id IN ({zs})", (day, store))
        db.execute("INSERT OR IGNORE INTO legacy_z (source_id, reg_num, z_counter, day, z_at) SELECT ?, reg, z, day, z_at FROM sz WHERE day = ?",
                   (source_id, day))
        db.execute("""INSERT OR IGNORE INTO legacy_receipts (source_id, reg_num, receipt_num, z_id, day, at, mode, cashier,
                        total_cents, tax_cents, age_verified, dob, disc_cents)
                      SELECT ?, sr.reg, sr.num, lz.id, ?, sr.at, sr.mode, sr.cashier, sr.total, sr.tax, sr.age, COALESCE(sr.dob, ''),
                        COALESCE(sr.disc, 0)
                      FROM sz CROSS JOIN sr ON sr.reg = sz.reg AND sr.z = sz.z
                      CROSS JOIN legacy_z lz ON lz.source_id = ? AND lz.reg_num = sr.reg AND lz.z_counter = sr.z
                      WHERE sz.day = ? ORDER BY sr.at, sr.num""", (source_id, day, source_id, day))
        db.execute("""INSERT INTO legacy_lines (receipt_id, seq, day, mode, cls, type, flags, kind, dept, lottery, upc, name, brand,
                        qty, unit_cents, amount_cents, unit_cost_c4, cost_cents, has_cost, voided, returned, cur_dept, disc_cents, name_src)
                      SELECT r.id, sl.seq, ?, r.mode, sl.cls, sl.type, sl.flags, sl.kind, sl.dept, sl.lottery, sl.upc, sl.name,
                        sl.brand, sl.qty, sl.unit, sl.amount, sl.cost4, sl.cost, sl.has_cost, sl.voided, sl.returned, sl.cur_dept, sl.disc,
                        sl.name_src
                      FROM legacy_receipts r CROSS JOIN sl ON sl.reg = r.reg_num AND sl.num = r.receipt_num
                      WHERE r.day = ? AND r.source_id = ? ORDER BY r.id, sl.seq""", (day, day, source_id))
        db.execute("""INSERT INTO legacy_tenders (receipt_id, seq, type, name, amount_cents, change_cents, sale_cents)
                      SELECT r.id, st.seq, st.type, st.name, st.amount, st.change, st.sale
                      FROM legacy_receipts r CROSS JOIN st ON st.reg = r.reg_num AND st.num = r.receipt_num
                      WHERE r.day = ? AND r.source_id = ? ORDER BY r.id, st.seq""", (day, source_id))
        db.execute("""INSERT OR REPLACE INTO legacy_z_values (z_id, name, cents)
                      SELECT lz.id, sv.name, sv.cents FROM legacy_z lz CROSS JOIN sv ON sv.reg = lz.reg_num AND sv.z = lz.z_counter
                      WHERE lz.day = ? AND lz.source_id = ?""", (day, source_id))
        n = db.execute("SELECT COUNT(*) FROM legacy_receipts WHERE day = ? AND source_id IN "
                       "(SELECT id FROM legacy_sources WHERE store = ?)", (day, store)).fetchone()[0]
        db.execute("INSERT OR REPLACE INTO legacy_days (store, day, source_id, partial, receipts, variances, imported_at) "
                   "VALUES (?, ?, ?, ?, ?, 0, ?)", (store, day, source_id, int(partial), n, now))
        check_day(db, day)
        v = db.execute("SELECT variances FROM legacy_days WHERE store = ? AND day = ?", (store, day)).fetchone()[0]
        db.execute("COMMIT")
        return n, v
    except BaseException:
        db.execute("ROLLBACK")
        raise


# Z_Totals: which of ILSA's amounts equals which of our totals is learned from the days themselves
# (the column names don't say): a column that equals one of ours on 90% of the days or more is checked.
BUCKETS = ["ours:merchandise", "ours:items", "ours:entrys", "ours:promos", "ours:others", "ours:net", "ours:gross",
           "ours:sale_totals", "ours:tax", "ours:payouts", "ours:lottery", "ours:discounts",
           "ours:promos+discounts", "ours:others+discounts"]
BUCKET_TEXT = {"ours:merchandise": "item sales (lottery out)", "ours:items": "item sales (lottery in)",
               "ours:entrys": "dept entries", "ours:promos": "promotions", "ours:others": "other lines",
               "ours:net": "net sales", "ours:gross": "sales with tax", "ours:sale_totals": "receipt totals",
               "ours:tax": "tax", "ours:payouts": "paid outs", "ours:lottery": "lottery item sales",
               "ours:discounts": "receipt discounts", "ours:promos+discounts": "promotions + receipt discounts",
               "ours:others+discounts": "other lines + receipt discounts"}


def name_backfill(db):
    """Lines named after their department (no item list had their UPC) take the name and brand from
    any imported copy's item list that has it (the newest copy's first). Returns (named now, still unnamed)."""
    db.execute("BEGIN")
    cur = db.execute("""UPDATE legacy_lines SET (name, brand, name_src) =
                          (SELECT i.name, i.brand, 'other' FROM legacy_items i JOIN legacy_sources s ON s.id = i.source_id
                           WHERE i.bare = ltrim(legacy_lines.upc, '0') ORDER BY s.last_day DESC, s.id DESC LIMIT 1)
                        WHERE name_src = 'dept' AND upc <> '' AND kind = 'item'
                          AND EXISTS (SELECT 1 FROM legacy_items i WHERE i.bare = ltrim(legacy_lines.upc, '0'))""")
    named = cur.rowcount
    db.execute("COMMIT")
    left = db.execute("SELECT COUNT(DISTINCT upc), COUNT(*) FROM legacy_lines WHERE name_src = 'dept' AND upc <> '' AND kind = 'item'").fetchone()
    return named, left


def learn_z_totals(db, tx=True):
    """Matches Z_Totals columns to our totals over every day in the file (either sign: ILSA keeps some
    amounts positive that its receipts keep negative); rewrites their variances."""
    vals = defaultdict(dict)
    for z, name, c in db.execute("SELECT z_id, name, cents FROM legacy_z_values WHERE name LIKE 'ilsa:totals:%' OR name LIKE 'ours:%'"):
        vals[z][name] = c
    for v in vals.values():
        v["ours:promos+discounts"] = v.get("ours:promos", 0) + v.get("ours:discounts", 0)
        v["ours:others+discounts"] = v.get("ours:others", 0) + v.get("ours:discounts", 0)
        for b in BUCKETS:
            v["-" + b] = -v.get(b, 0)
    signed = BUCKETS + ["-" + b for b in BUCKETS]
    cols = sorted({n for v in vals.values() for n in v if n.startswith("ilsa:totals:")})
    mapping = {}
    for col in cols:
        days = [v for v in vals.values() if col in v]
        if not days or all(v[col] == 0 for v in days):
            continue
        best = max(signed, key=lambda b: sum(1 for v in days if abs(v[col] - v.get(b, 0)) <= 1))
        hits = sum(1 for v in days if abs(v[col] - v.get(best, 0)) <= 1)
        mapping[col] = (best, hits, len(days))
    if tx:
        db.execute("BEGIN")
    db.execute("DELETE FROM legacy_variances WHERE what LIKE 'Z_Totals %'")
    var = []
    for col, (b, hits, n) in mapping.items():
        if hits < 0.9 * n:
            continue
        for z, v in vals.items():
            if col in v and abs(v[col] - v.get(b, 0)) > 1:
                var.append((z, f"Z_Totals {col[12:]} vs {bucket_text(b)}", v[col], v.get(b, 0)))
    db.executemany("INSERT INTO legacy_variances (day, z_id, what, ilsa_cents, ours_cents) SELECT day, ?, ?, ?, ? FROM legacy_z WHERE id = ?",
                   [(z, w, a, b, z) for z, w, a, b in var])
    db.execute("""UPDATE legacy_days SET variances = (SELECT COUNT(*) FROM legacy_variances v JOIN legacy_z z ON z.id = v.z_id
                       JOIN legacy_sources s ON s.id = z.source_id WHERE v.day = legacy_days.day AND s.store = legacy_days.store)""")
    if tx:
        db.execute("COMMIT")
    return mapping


def bucket_text(b):
    return ("minus " + BUCKET_TEXT[b[1:]]) if b.startswith("-") else BUCKET_TEXT[b]


def money(c):
    return f"-${-c / 100:,.2f}" if c < 0 else f"${c / 100:,.2f}"


def report(db, days, out_dir, stamp, say):
    """The self-check: what matched, and every difference (also saved as a CSV)."""
    if not days:
        return None
    marks = ",".join("?" * len(days)) if len(days) < 900 else None
    where = f"v.day IN ({marks})" if marks else "v.day BETWEEN ? AND ?"
    args = days if marks else [days[0], days[-1]]
    var = db.execute(f"""SELECT v.day, z.reg_num, z.z_counter, v.what, v.ilsa_cents, v.ours_cents FROM legacy_variances v
                         LEFT JOIN legacy_z z ON z.id = v.z_id WHERE {where} ORDER BY v.day, v.what""", args).fetchall()
    zs = db.execute(f"SELECT COUNT(*) FROM legacy_z v WHERE {where}", args).fetchone()[0]
    by = Counter(w if not w.startswith("Tender") else w for _, _, _, w, _, _ in var)
    bad_days = {d for d, *_ in var}
    say(f"\n== Self-check: {len(days):,} day(s), {zs:,} ILSA Z(s); {len(days) - len(bad_days):,} day(s) match ILSA's Z on everything checked")
    for w, n in by.most_common():
        say(f"  differs on {n:,} Z(s): {w}")
    path = None
    if var:
        os.makedirs(out_dir, exist_ok=True)
        path = os.path.join(out_dir, f"variances-{stamp}.csv")
        with open(path, "w", newline="", encoding="utf-8-sig") as f:
            w = csv.writer(f)
            w.writerow(["day", "register", "z", "what", "ilsa", "imported", "difference"])
            for d, reg, z, what, a, b in var:
                cnt = what.endswith("(count)")
                w.writerow([d, reg, z, what, a if cnt else f"{a / 100:.2f}", b if cnt else f"{b / 100:.2f}",
                            (b - a) if cnt else f"{(b - a) / 100:.2f}"])
        worst = sorted((r for r in var if not r[3].endswith("(count)")), key=lambda r: -abs(r[5] - r[4]))[:10]
        if worst:
            say("  largest differences (imported - ILSA):")
            for d, reg, z, what, a, b in worst:
                say(f"    {d} Z {z}: {what}: ILSA {money(a)}, imported {money(b)} ({money(b - a)})")
        say(f"  every difference: {path}")
    return path


# --- ViewTouch stopped while the file changes ---------------------------------------------------------

def running():
    return subprocess.run(["pgrep", "-x", "vtmodern"], capture_output=True).returncode == 0


def stop_viewtouch():
    if not running():
        return False
    print("Stopping ViewTouch (it saves first)...")
    subprocess.run(["pkill", "-TERM", "-x", "vtmodern"])
    for _ in range(40):
        if not running():
            return True
        time.sleep(0.5)
    sys.exit("ViewTouch didn't stop; nothing was changed.")


def set_prefix(db, prefix, source=None):
    """The store (its check prefix: receipts show as BHDAN-836100) of one copy, or of every copy; its
    days move with it."""
    prefix = re.sub(r"[^A-Za-z0-9]", "", prefix or "").upper()
    if not prefix:
        sys.exit("--prefix: letters, like BHDAN")
    where, args = ("WHERE name = ?", (source,)) if source else ("", ())
    db.execute(f"UPDATE legacy_sources SET store = ? {where}", (prefix,) + args)
    db.execute(f"UPDATE OR REPLACE legacy_days SET store = ? WHERE source_id IN (SELECT id FROM legacy_sources {where})", (prefix,) + args)
    db.commit()
    return prefix


# What a store's ILSA copy calls itself (Sys_Pram: store name, city): words that must be there.
STORE_WORDS = {"BHDAN": ["DANBURY"], "BHNM": ["GAYLORDSVILLE", "NEW MILFORD"], "HCA": ["HAT CITY"]}


def check_store(export, store, force, say):
    """Refuses (exit) an export whose own store name / city (Sys_Pram) doesn't fit `store`, unless force."""
    table = next((f[:-4] for f in os.listdir(export) if f.lower() in ("sys_pram.csv", "syspram.csv", "sys_param.csv")), None)
    words = STORE_WORDS.get(store)
    if not table:
        say(f"  store: no Sys_Pram table to check the export is {store}'s")
        return
    h, it = rows(export, table); r = Row(h)
    shown, text = [], []
    for r.r in it:
        for c in h:
            v = r(c).strip()
            if v and not re.search(r"PIN|PASS|PWD|SSN|KEY|LICEN|SERIAL|ACCT|MERCH|TERM_ID", c):
                text.append(v.upper())
                if re.search(r"STORE|NAME|CITY|TOWN|ADDR|STATE", c) and len(shown) < 6 and not v.replace(".", "").isdigit():
                    shown.append(f"{c}={v}")
    say(f"  store: {table} says " + ("; ".join(shown) or "(no store name or city found)"))
    if not words:
        say(f"  store {store}: no words known for it; not checked")
        return
    if not any(w in t for w in words for t in text):
        msg = f"This export doesn't look like {store}'s ({' / '.join(words)} not found in {table})."
        if force:
            say("  " + msg + " Imported anyway (--force).")
        else:
            sys.exit(msg + " Give the right --prefix, or --force if it is.")


def run(export, db_path, day_from, day_to, dry, replace, out_dir, quiet=False, now=None, manage=True, prefix=None, force=False):
    say = (lambda *a: None) if quiet else print
    t0 = time.time()
    now = now or time.strftime("%Y-%m-%d %H:%M:%S")
    stamp = time.strftime("%Y-%m-%d_%H%M%S")
    source = os.path.basename(os.path.normpath(export))
    was_running = False
    scratch = None
    if dry:
        fd, scratch = tempfile.mkstemp(prefix="ilsa-history-dry-", suffix=".db"); os.close(fd)
        if os.path.exists(db_path):   # the days already in count as in
            shutil.copyfile(db_path, scratch)
        db_path = scratch
        say(f"DRY RUN: {source} into a scratch copy (nothing is kept, ViewTouch keeps running)")
    else:
        os.makedirs(os.path.dirname(os.path.abspath(db_path)), exist_ok=True)
        if manage:
            was_running = stop_viewtouch()
        if os.path.exists(db_path):
            os.makedirs(os.path.join(out_dir, "backups"), exist_ok=True)
            backup = os.path.join(out_dir, "backups", f"ilsa-history-before-{stamp}.db")
            src, dst = sqlite3.connect(db_path), sqlite3.connect(backup)
            src.backup(dst); dst.close(); src.close()
            say(f"Backup: {backup}")
        say(f"Importing {source} into {db_path}")
    try:
        db = open_db(db_path)
        db.execute("INSERT OR IGNORE INTO legacy_sources (name) VALUES (?)", (source,))
        source_id = db.execute("SELECT id FROM legacy_sources WHERE name = ?", (source,)).fetchone()[0]
        db.commit()
        if prefix:
            set_prefix(db, prefix, source)
        store = db.execute("SELECT store FROM legacy_sources WHERE id = ?", (source_id,)).fetchone()[0]
        say(f"Store {store} (receipts show as {store}-<number>)")
        try:
            check_store(export, store, force, say)
        except SystemExit:   # nothing imported: the file as it was
            if prefix:
                db.rollback()
            db.close()
            raise
        done = set() if replace else {d for (d,) in db.execute("SELECT day FROM legacy_days WHERE partial = 0 AND store = ?", (store,))}
        partial_in = {d for (d,) in db.execute("SELECT day FROM legacy_days WHERE partial = 1 AND store = ?", (store,))}
        days, last = stage(db, export, day_from, day_to, done, say, source_id)
        db.commit()
        if not days:
            say("Nothing to import: every day in that range is in already (--replace imports them again).")
        receipts = variances = 0
        for i, d in enumerate(days):
            n, v = import_day(db, source_id, store, d, d == last, replace or d in partial_in, now)
            receipts += n; variances += v
            if not quiet and (i % 100 == 99 or i == len(days) - 1):
                print(f"  {i + 1:,}/{len(days):,} days ({d}), {receipts:,} receipts, {time.time() - t0:,.0f} s", flush=True)
        if days:
            first_all, last_all = db.execute("SELECT MIN(day), MAX(day) FROM legacy_days WHERE source_id = ?", (source_id,)).fetchone()
            db.execute("UPDATE legacy_sources SET first_day = ?, last_day = ?, imported_at = ? WHERE id = ?",
                       (first_all, last_all, now, source_id))
            db.execute("INSERT OR REPLACE INTO legacy_meta VALUES ('last_import', ?)", (now,))
            db.commit()
            mapping = learn_z_totals(db)
            if mapping and not quiet:
                say("\n== ILSA Z_Totals amounts (meaning learned from the days: equal to one of ours on most days)")
                for col, (b, hits, n) in sorted(mapping.items()):
                    say(f"  {col[12:]}: = {bucket_text(b)} on {hits:,} of {n:,} Z's" + ("  (checked)" if hits >= 0.9 * n else ""))
        if days and not db.execute("SELECT 1 FROM legacy_receipts WHERE source_id = ? AND dob <> '' LIMIT 1", (source_id,)).fetchone():
            say("\nBirth dates: RegSale has none; looking in the other tables")
            fill_dob(db, export, source_id, say)
        named, (codes, lines) = name_backfill(db)
        if named or codes:
            say(f"\nItems no longer in their copy's list: {named:,} line(s) named from another copy's list;"
                f" {lines:,} line(s) on {codes:,} UPC(s) still named after their department (ILSA Differences lists them).")
        path = report(db, days, out_dir, stamp, say)
        totals = db.execute("SELECT COUNT(*), MIN(day), MAX(day) FROM legacy_days").fetchone()
        close_db(db)
        say(f"\nDone in {time.time() - t0:,.0f} s: {len(days):,} day(s), {receipts:,} receipts imported this run."
            f" The history file has {totals[0]:,} days ({totals[1]} .. {totals[2]}).")
        return {"days": days, "receipts": receipts, "variances": variances, "csv": path}
    finally:
        if scratch:
            for suffix in ("", "-wal", "-shm"):
                if os.path.exists(scratch + suffix):
                    os.remove(scratch + suffix)
        if was_running:
            print("Starting ViewTouch again...")
            subprocess.Popen(["vt-server"])


# --- --recheck: the self-check again, from the history file -------------------------------------------

def explain(db, what_like, cands, say):
    """For the Z's that differ on `what_like`: does the difference (ILSA - imported) equal one of
    `cands` (name -> SQL giving z_id, cents for the Z's of a day range), or minus it?"""
    bad = db.execute("SELECT v.z_id, v.ilsa_cents - v.ours_cents, substr(v.day, 1, 4) FROM legacy_variances v "
                     "WHERE v.what LIKE ? AND v.what NOT LIKE '%known:%'", (what_like,)).fetchall()
    if not bad:
        return
    say(f"  {len(bad):,} Z's; by year: " + ", ".join(f"{y} {n}" for y, n in sorted(Counter(y for _, _, y in bad).items())))
    diffs = {z: d for z, d, _ in bad}
    for name, sql in cands.items():
        vals = dict(db.execute(sql).fetchall())
        hit = sum(1 for z, d in diffs.items() if vals.get(z, 0) and abs(d - vals[z]) <= 1)
        neg = sum(1 for z, d in diffs.items() if vals.get(z, 0) and abs(d + vals[z]) <= 1)
        if hit or neg:
            say(f"    = {name}: {hit:,} Z's; = minus it: {neg:,}")
    sizes = sorted(diffs.values())
    small = sum(1 for d in sizes if abs(d) <= 5)
    say(f"    differences: {small:,} of 5 cents or less; smallest {money(sizes[0])}, largest {money(sizes[-1])}; "
        "most common: " + ", ".join(f"{money(d)} x{n}" for d, n in Counter(sizes).most_common(5)))


def dates_report(db, say):
    """Days and receipts whose dates look wrong (a register clock set wrong): what they are."""
    say("\n== Dates")
    for sid, name, first, last in db.execute("SELECT id, name, first_day, last_day FROM legacy_sources ORDER BY first_day"):
        say(f"  {name}: {first} .. {last}")
    # Each copy's days far from the rest of its days (more than 30 days before the next one).
    for sid, name in db.execute("SELECT id, name FROM legacy_sources ORDER BY first_day").fetchall():
        days = [d for (d,) in db.execute("SELECT day FROM legacy_days WHERE source_id = ? ORDER BY day", (sid,))]
        lone = [d for i, d in enumerate(days) if i + 1 < len(days) and i < 20 and
                (time.mktime(time.strptime(days[i + 1], "%Y-%m-%d")) - time.mktime(time.strptime(d, "%Y-%m-%d"))) > 30 * 86400]
        for d in lone:
            say(f"  {name}: {d} stands apart from its copy's other days (the next is more than 30 days later):")
            for zc, zat, n, a, b in db.execute(
                    "SELECT z.z_counter, z.z_at, COUNT(r.id), MIN(r.at), MAX(r.at) FROM legacy_z z "
                    "LEFT JOIN legacy_receipts r ON r.z_id = z.id WHERE z.day = ? AND z.source_id = ? GROUP BY z.id", (d, sid)):
                dates = db.execute("SELECT substr(r.at, 1, 10), COUNT(*) FROM legacy_receipts r JOIN legacy_z z ON z.id = r.z_id "
                                   "WHERE z.day = ? AND z.source_id = ? AND z.z_counter = ? GROUP BY 1 ORDER BY 2 DESC LIMIT 4",
                                   (d, sid, zc)).fetchall()
                say(f"    Z {zc}: run {zat or '?'}; {n} receipt(s) rung {a} .. {b}; their dates: "
                    + ", ".join(f"{x} x{c}" for x, c in dates))
    # Z's whose receipts were rung on more than one date, or more than a day from when the Z was run.
    rows = db.execute("SELECT s.name, z.day, z.z_counter, z.z_at, MIN(substr(r.at, 1, 10)), MAX(substr(r.at, 1, 10)), COUNT(r.id) "
                      "FROM legacy_z z JOIN legacy_sources s ON s.id = z.source_id JOIN legacy_receipts r ON r.z_id = z.id "
                      "GROUP BY z.id HAVING julianday(MAX(r.at)) - julianday(MIN(r.at)) > 1.5 "
                      "OR (z.z_at <> '' AND abs(julianday(substr(z.z_at, 1, 10)) - julianday(z.day)) > 1) ORDER BY z.day").fetchall()
    say(f"  Z's whose receipts span more than a day, or run more than a day after their first receipt: {len(rows):,}")
    for name, d, zc, zat, a, b, n in rows[:15]:
        say(f"    {name} Z {zc} (day {d}, run {zat or '?'}): {n} receipts dated {a} .. {b}")


RECHECK_CANDIDATES = {
    "Tax": {
        "tax on cancelled / no-sale receipts (modes 1, 2)": "SELECT z_id, SUM(tax_cents) FROM legacy_receipts WHERE mode <> 0 GROUP BY z_id",
        "tax on receipts with a return": "SELECT r.z_id, SUM(r.tax_cents) FROM legacy_receipts r WHERE r.mode = 0 AND EXISTS "
                                         "(SELECT 1 FROM legacy_lines l WHERE l.receipt_id = r.id AND l.returned = 1) GROUP BY r.z_id",
        "tax on receipts with a negative total": "SELECT z_id, SUM(tax_cents) FROM legacy_receipts WHERE mode = 0 AND total_cents < 0 GROUP BY z_id",
        "tax on receipts dated another day than their Z": "SELECT r.z_id, SUM(r.tax_cents) FROM legacy_receipts r WHERE r.mode = 0 "
                                                           "AND substr(r.at, 1, 10) <> r.day GROUP BY r.z_id",
    },
    "Tender Cash": {
        "change given on card / gift card / check tenders": "SELECT r.z_id, SUM(t.change_cents) FROM legacy_tenders t JOIN legacy_receipts r "
                                                             "ON r.id = t.receipt_id WHERE t.type <> 1 GROUP BY r.z_id",
        "cash given back (negative cash tenders)": "SELECT r.z_id, SUM(t.amount_cents) FROM legacy_tenders t JOIN legacy_receipts r "
                                                    "ON r.id = t.receipt_id WHERE t.type = 1 AND t.amount_cents < 0 GROUP BY r.z_id",
        "paid outs": "SELECT r.z_id, SUM(l.amount_cents) FROM legacy_lines l JOIN legacy_receipts r ON r.id = l.receipt_id "
                     "WHERE l.kind = 'payout' GROUP BY r.z_id",
        "cash on cancelled / no-sale receipts": "SELECT r.z_id, SUM(t.amount_cents - t.change_cents) FROM legacy_tenders t JOIN legacy_receipts r "
                                                "ON r.id = t.receipt_id WHERE t.type = 1 AND r.mode <> 0 GROUP BY r.z_id",
        "cash on receipts dated another day than their Z": "SELECT r.z_id, SUM(t.amount_cents - t.change_cents) FROM legacy_tenders t "
                                                            "JOIN legacy_receipts r ON r.id = t.receipt_id WHERE t.type = 1 "
                                                            "AND substr(r.at, 1, 10) <> r.day GROUP BY r.z_id",
    },
}


def recheck(db_path, day_from, day_to, dry, out_dir, quiet=False, store=None):
    """The self-check again over the history file's days (no export, nothing imported): our totals
    rebuilt, the differences rewritten, then what explains each kind and the dates that look wrong.
    --dry-run prints it all and keeps the file as it was."""
    say = (lambda *a: None) if quiet else print
    if not os.path.exists(db_path):
        sys.exit(f"No history file at {db_path}: import first.")
    t0 = time.time()
    stamp = time.strftime("%Y-%m-%d_%H%M%S")
    RECEIPT_STATS.clear(); RECEIPT_DIFFS.clear(); NO_SAVED_TENDERS.clear()
    if not dry:   # the differences are rewritten: a copy first
        os.makedirs(os.path.join(out_dir, "backups"), exist_ok=True)
        backup = os.path.join(out_dir, "backups", f"ilsa-history-before-recheck-{stamp}.db")
        src, dst = sqlite3.connect(db_path), sqlite3.connect(backup)
        src.backup(dst); dst.close(); src.close()
        say(f"Backup: {backup}")
    db = open_db(db_path)
    days = [d for (d,) in db.execute("SELECT DISTINCT day FROM legacy_days WHERE day BETWEEN ? AND ? AND (? = '' OR store = ?) ORDER BY day",
                                     (day_from or "0000", day_to or "9999", (store or "").upper(), (store or "").upper()))]
    say(("DRY RUN (nothing kept): " if dry else "") + f"rechecking {len(days):,} day(s) in {db_path}")
    db.execute("BEGIN")
    try:
        for i, d in enumerate(days):
            check_day(db, d)
            if not quiet and (i % 500 == 499 or i == len(days) - 1):
                print(f"  {i + 1:,}/{len(days):,} days ({d}), {time.time() - t0:,.0f} s", flush=True)
        mapping = learn_z_totals(db, tx=False)
        say("\n== Receipts: total against lines + tax")
        for k, n in RECEIPT_STATS.most_common():
            say(f"  {k}: {n:,}")
        if RECEIPT_DIFFS:
            say("  unexplained, most common differences (total - lines - tax): "
                + ", ".join(f"{money(d)} x{n:,}" for d, n in RECEIPT_DIFFS.most_common(8)))
        if NO_SAVED_TENDERS:
            say("  Z's whose ILSA Z kept no tenders (not compared), by year: "
                + ", ".join(f"{y} {n}" for y, n in sorted(NO_SAVED_TENDERS.items())))
        say("\n== ILSA Z_Totals amounts (meaning learned from the days)")
        for col, (b, hits, n) in sorted(mapping.items()):
            say(f"  {col[12:]}: = {bucket_text(b)} on {hits:,} of {n:,} Z's" + ("  (checked)" if hits >= 0.9 * n else ""))
        for what, cands in RECHECK_CANDIDATES.items():
            say(f"\n== {what}: ILSA's Z - imported, on the Z's that differ")
            explain(db, what + "%", cands, say)
        dates_report(db, say)
        report(db, days, out_dir, stamp, say)
        db.execute("ROLLBACK" if dry else "COMMIT")
    except BaseException:
        db.execute("ROLLBACK")
        raise
    close_db(db)
    say(f"\nDone in {time.time() - t0:,.0f} s" + (" (dry run: the history file is unchanged)." if dry else "."))
    return dict(RECEIPT_STATS)


# --- self-test on made-up data -------------------------------------------------------------------------

def write_csv(d, name, header, data):
    with open(os.path.join(d, name + ".csv"), "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f); w.writerow(header); w.writerows(data)


def made_up_export(d):
    """A tiny made-up ILSA export: two days, one register. Day 1 (2026-10-27) matches its Z; day 2
    (2026-10-28) has a void pair, a return, a dept 260 open ring with no cost, a lottery sale, a coupon
    entry, a promotion, a paid out, a cancelled (mode 1) receipt, and its Z's cash is $1.00 off."""
    write_csv(d, "RegZCnt", ["REG_NUM", "REG_Z_COUNTER", "REG_Z_DATETIME"],
              [[1, 501, "10/27/26 21:05:00"], [1, 502, "10/28/26 21:10:00"]])
    write_csv(d, "RegSale", ["REG_NUM", "RECEIPT_NUM", "REG_Z_COUNTER", "START_TIME", "Z_MODE", "CSHR_NUM", "SALE_TOTAL",
                             "TAX1_AMT", "TAX1_REFUND_AMT", "AGE_VERIFIED", "BUYER_DOB"],
              [[1, 9001, 501, "10/27/26 10:00:00", 0, 3, "10.63", "0.63", "0", 21, "01/02/80"],
               [1, 9002, 501, "10/27/26 15:30:00", 0, 3, "5.00", "0", "0", 0, ""],
               [1, 9003, 502, "10/28/26 09:15:00", 0, 4, "26.58", "1.58", "0", 21, "03/04/1975"],
               [1, 9004, 502, "10/28/26 11:00:00", 0, 4, "-10.63", "0", "0.63", 0, ""],
               [1, 9005, 502, "10/28/26 12:00:00", 1, 4, "7.00", "0", "0", 0, ""],
               [1, 9006, 502, "10/28/26 13:00:00", 0, 4, "-20.00", "0", "0", 0, ""]])
    cols = ["REG_NUM", "REG_Z_COUNTER", "RECEIPT_NUM", "DETAIL_CLASS", "DETAIL_TYPE", "MODE_FLAGS", "DEPT", "PLU",
            "DETAIL_ITEM_PRC", "DETAIL_FOR_QTY", "DETAIL_LINE_AMT", "ITEM_COST", "TIME_STAMP"]
    write_csv(d, "PDetail", cols, [
        [1, 501, 9001, 1, 1, 0, 10, "012345678905", "10.00", 1, "10.00", "7.00", "10/27/26 10:00:00"],
        [1, 501, 9002, 1, 1, 0, 275, "", "5.00", 1, "5.00", "0", "10/27/26 15:30:00"],          # lottery
        [1, 502, 9003, 1, 1, 0, 10, "012345678905", "10.00", 2, "20.00", "7.00", "10/28/26 09:15:00"],
        [1, 502, 9003, 1, 1, 1, 20, "098765432109", "4.00", 1, "4.00", "2.50", "10/28/26 09:15:00"],   # voided
        [1, 502, 9003, 1, 1, 128, 20, "098765432109", "4.00", 1, "-4.00", "2.50", "10/28/26 09:15:00"],
        [1, 502, 9003, 1, 1, 0, 260, "", "6.00", 1, "6.00", "0", "10/28/26 09:15:00"],          # open ring, no cost
        [1, 502, 9003, 15, 7, 0, 10, "", "0", 1, "-1.00", "0", "10/28/26 09:15:00"],             # promotion
        [1, 502, 9003, 9, 15, 0, 10, "012345678905", "0", 1, "0", "7.00", "10/28/26 09:15:00"],  # stock move: skipped
        [1, 502, 9004, 1, 1, 256, 10, "012345678905", "10.00", 1, "-10.00", "7.00", "10/28/26 11:00:00"],  # return
        [1, 502, 9005, 1, 1, 0, 20, "098765432109", "7.00", 1, "7.00", "2.50", "10/28/26 12:00:00"],  # mode 1
        [1, 502, 9006, 4, 1, 0, 0, "", "0", 1, "-20.00", "0", "10/28/26 13:00:00"],             # paid out
        [1, 502, 9001, 9, 15, 0, 10, "", "0", 1, "0", "0", "10/28/26 13:00:00"],
    ])
    write_csv(d, "TendSale", ["REG_NUM", "REG_Z_COUNTER", "RECEIPT_NUM", "TENDER_TYPE", "SALE_AMT", "AMT_TEND", "CHANGE_DUE"],
              [[1, 501, 9001, 1, "10.63", "20.00", "9.37"], [1, 501, 9002, 70, "5.00", "5.00", "0"],
               [1, 502, 9003, 70, "26.58", "20.00", "0"], [1, 502, 9003, 1, "26.58", "10.00", "3.42"],
               [1, 502, 9004, 1, "-10.63", "-10.63", "0"], [1, 502, 9006, 1, "-20.00", "-20.00", "0"]])
    write_csv(d, "Z_Tender", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "TENDER_TYPE", "TENDER_AMT", "Z_MODE"],
              [[1, 501, 0, 1, "10.63", 0], [1, 501, 0, 70, "5.00", 0],
               [1, 502, 0, 1, "-23.05", 0], [1, 502, 0, 70, "20.00", 0]])   # cash really -24.05: $1.00 off
    write_csv(d, "Z_Taxes", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "Z_MODE", "TAX1_AMT", "TAX1_REFUND_AMT"],
              [[1, 501, 0, 0, "0.63", "0"], [1, 502, 0, 0, "1.58", "0.63"], [1, 502, 3, 0, "9.99", "0"]])
    write_csv(d, "Z_Totals", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "Z_PLU_AMT", "Z_SALE_COUNT"],
              [[1, 501, 0, "15.00", 0], [1, 502, 0, "16.00", 0]])
    write_csv(d, "RegReconcile", ["REG_NUM", "REG_Z_COUNTER", "Z_PAYOUTS"], [[1, 501, "0"], [1, 502, "20.00"]])
    write_csv(d, "PLU", ["PLU_NUM", "PLU_DESC", "POS_DESC", "DEPT_NUM", "MANUF"],
              [["12345678905", "MADE UP CIGAR ROBUSTO", "", 10, "Acme Cigars"],
               ["012345678905", "MADE UP CIGAR ROBUSTO", "", 10, "Acme Cigars"],
               ["098765432109", "MADE UP LIGHTER", "", 30, "Sparky"],
               ["055555555555", "MADE UP CUTTER", "", 20, "Sparky"]])
    write_csv(d, "Dept", ["DEPT_NUM", "DEPT_NAME"], [[10, "CIGARS"], [20, "ACCESSORIES"], [30, "LIGHTERS"], [260, "OPEN RING"],
                                                     [275, "INSTANT LOTTERY"], [0, "PAID OUT"]])
    write_csv(d, "PRC_ADJ", ["ID", "PRC_NAME"], [[7, "BUY 2 SAVE 1"]])
    write_csv(d, "Sys_Pram", ["STORE_NAME", "STORE_CITY", "STORE_STATE"], [["MADE UP TOBACCO", "DANBURY", "CT"]])
    write_csv(d, "Cashier", ["CSHR_NUM", "CSHR_NAME", "CSHR_PIN", "PAY_RATE"],
              [[3, "Test Cashier Three", "9999", "1.00"], [4, "Test Cashier Four", "8888", "1.00"]])


def older_export(d):
    """A made-up older copy: one day (2026-10-20) selling an item its own list no longer has (the newer
    copy's list does: MADE UP CUTTER) and one no list has."""
    write_csv(d, "RegZCnt", ["REG_NUM", "REG_Z_COUNTER", "REG_Z_DATETIME"], [[1, 401, "10/20/26 21:00:00"]])
    write_csv(d, "RegSale", ["REG_NUM", "RECEIPT_NUM", "REG_Z_COUNTER", "START_TIME", "Z_MODE", "CSHR_NUM", "SALE_TOTAL",
                             "TAX1_AMT", "TAX1_REFUND_AMT", "RT_AMT_DISCOUNTS"],
              [[1, 8001, 401, "10/20/26 10:00:00", 0, 2, "5.32", "0.32", "0", "0"],
               [1, 8002, 401, "10/20/26 11:00:00", 0, 2, "9.57", "0.57", "0", "1.00"]])   # $1.00 off the receipt
    write_csv(d, "PDetail", ["REG_NUM", "REG_Z_COUNTER", "RECEIPT_NUM", "DETAIL_CLASS", "DETAIL_TYPE", "MODE_FLAGS", "DEPT", "PLU",
                             "DETAIL_ITEM_PRC", "DETAIL_FOR_QTY", "DETAIL_LINE_AMT", "ITEM_COST", "TIME_STAMP"],
              [[1, 401, 8001, 1, 1, 0, 20, "55555555555", "3.00", 1, "3.00", "1.00", "10/20/26 10:00:00"],
               [1, 401, 8001, 1, 1, 0, 20, "077777777777", "2.00", 1, "2.00", "0.50", "10/20/26 10:00:00"],
               [1, 401, 8002, 1, 1, 0, 20, "55555555555", "10.00", 1, "10.00", "1.00", "10/20/26 11:00:00"]])
    write_csv(d, "TendSale", ["REG_NUM", "REG_Z_COUNTER", "RECEIPT_NUM", "TENDER_TYPE", "SALE_AMT", "AMT_TEND", "CHANGE_DUE"],
              [[1, 401, 8001, 1, "5.32", "5.32", "0"], [1, 401, 8002, 1, "9.57", "10.00", "0.43"]])
    write_csv(d, "Z_Tender", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "TENDER_TYPE", "TENDER_AMT"], [[1, 401, 0, 1, "14.89"]])
    write_csv(d, "Z_Taxes", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "TAX1_AMT"], [[1, 401, 0, "0.89"]])
    write_csv(d, "PLU", ["PLU_NUM", "PLU_DESC", "DEPT_NUM", "MANUF"], [["11111111111", "OLD ITEM NEVER SOLD", 20, "Old Co"]])
    write_csv(d, "Dept", ["DEPT_NUM", "DEPT_NAME"], [[20, "OLD ACCESSORIES NAME"]])
    write_csv(d, "Sys_Pram", ["STORE_NAME", "STORE_CITY"], [["MADE UP TOBACCO", "DANBURY"]])
    write_csv(d, "Employee", ["EMP_NUM", "FIRST_NAME", "LAST_NAME", "SSN"], [[2, "Test", "Cashier Two", "000-00-0000"]])
    # made-up birth dates, in a table of their own (as some ILSA copies may keep them)
    write_csv(d, "AgeCheck", ["REG_NUM", "RECEIPT_NUM", "CHECKED_AT", "ID_VALUE"],
              [[1, 8001, "10/20/26 10:00:00", "07/04/76"]] + [[1, 7000 + i, "10/20/26 09:00:00", f"01/01/{50 + i:02d}"] for i in range(30)])


def other_store_export(d):
    """A made-up copy of another store (BHNM): one receipt on 2026-10-15 (in the C++ tests' history) or
    on `day`."""
    write_csv(d, "RegZCnt", ["REG_NUM", "REG_Z_COUNTER", "REG_Z_DATETIME"], [[1, 77, "10/15/26 21:00:00"]])
    write_csv(d, "RegSale", ["REG_NUM", "RECEIPT_NUM", "REG_Z_COUNTER", "START_TIME", "Z_MODE", "CSHR_NUM", "SALE_TOTAL", "TAX1_AMT"],
              [[1, 9003, 77, "10/15/26 12:00:00", 0, 9, "10.63", "0.63"]])   # the same receipt number as a BHDAN one
    write_csv(d, "PDetail", ["REG_NUM", "REG_Z_COUNTER", "RECEIPT_NUM", "DETAIL_CLASS", "DETAIL_TYPE", "MODE_FLAGS", "DEPT", "PLU",
                             "DETAIL_ITEM_PRC", "DETAIL_FOR_QTY", "DETAIL_LINE_AMT", "ITEM_COST", "TIME_STAMP"],
              [[1, 77, 9003, 1, 1, 0, 10, "012345678905", "10.00", 1, "10.00", "7.00", "10/15/26 12:00:00"]])
    write_csv(d, "TendSale", ["REG_NUM", "REG_Z_COUNTER", "RECEIPT_NUM", "TENDER_TYPE", "SALE_AMT", "AMT_TEND", "CHANGE_DUE"],
              [[1, 77, 9003, 1, "10.63", "10.63", "0"]])
    write_csv(d, "Z_Tender", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "TENDER_TYPE", "TENDER_AMT"], [[1, 77, 0, 1, "10.63"]])
    write_csv(d, "Z_Taxes", ["REG_NUM", "REG_Z_COUNTER", "CSHR_NUM", "TAX1_AMT"], [[1, 77, 0, "0.63"]])
    write_csv(d, "PLU", ["PLU_NUM", "PLU_DESC", "DEPT_NUM", "MANUF"], [["12345678905", "MADE UP CIGAR ROBUSTO", 10, "Acme Cigars"]])
    write_csv(d, "Dept", ["DEPT_NUM", "DEPT_NAME"], [[10, "CIGARS"]])
    write_csv(d, "Sys_Pram", ["STORE_NAME", "STORE_CITY"], [["MADE UP TOBACCO", "GAYLORDSVILLE"]])


def fixture_sql(db):
    """The file's tables and rows, one statement per line (the C++ tests' fixture)."""
    # The tables as the file has them (columns added later included), then their indexes.
    out = [" ".join(sql.split()) + ";" for (sql,) in db.execute(
        "SELECT sql FROM sqlite_master WHERE sql IS NOT NULL AND name LIKE 'legacy%' ORDER BY type DESC, rowid")]
    for t in DATA_TABLES:
        cols = [c[1] for c in db.execute(f"PRAGMA table_info({t})")]
        for r in db.execute(f"SELECT * FROM {t} ORDER BY 1, 2"):
            vals = ", ".join("NULL" if v is None else str(v) if isinstance(v, (int, float)) else
                             "'" + str(v).replace("'", "''") + "'" for v in r)
            out.append(f"INSERT INTO {t} ({', '.join(cols)}) VALUES ({vals});")
    return "\n".join(out) + "\n"


FIXTURE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "modern", "tests", "legacy_fixture.inc")


def self_test(write_fixture=False):
    ok = True
    def check(what, cond):
        nonlocal ok
        print(("  ok   " if cond else "  FAIL ") + what)
        ok = ok and bool(cond)
    with tempfile.TemporaryDirectory() as tmp:
        exp = os.path.join(tmp, "made up export"); os.makedirs(exp); made_up_export(exp)
        dbp, out = os.path.join(tmp, "ilsa-history.db"), os.path.join(tmp, "out")
        now = "2026-11-07 00:00:00"
        dry = run(exp, dbp, "2026-10-28", "2026-10-28", True, False, out, quiet=True, now=now, manage=False)
        check("dry run imports one day and finds its cash difference", dry["days"] == ["2026-10-28"] and dry["variances"] >= 1)
        check("dry run leaves no history file", not os.path.exists(dbp))
        res = run(exp, dbp, None, None, False, False, out, quiet=True, now=now, manage=False)
        check("both days imported", res["days"] == ["2026-10-27", "2026-10-28"] and res["receipts"] == 6)
        db = sqlite3.connect(dbp)
        q = lambda s, *a: db.execute(s, a).fetchone()
        check("stock move lines skipped", q("SELECT COUNT(*) FROM legacy_lines WHERE cls = 9")[0] == 0)
        check("10 lines kept", q("SELECT COUNT(*) FROM legacy_lines")[0] == 10)
        check("void pair nets to 0 and is marked", q("SELECT SUM(amount_cents), COUNT(*) FROM legacy_lines WHERE voided = 1") == (0, 2))
        check("return is negative with negative quantity and cost",
              q("SELECT amount_cents, qty, cost_cents FROM legacy_lines WHERE returned = 1") == (-1000, -1.0, -700))
        check("2 units x $7.00 cost", q("SELECT cost_cents FROM legacy_lines WHERE amount_cents = 2000")[0] == 1400)
        check("open ring has no cost", q("SELECT has_cost FROM legacy_lines WHERE dept = 260") == (0,))
        check("current department kept beside the one at sale",
              q("SELECT dept, cur_dept FROM legacy_lines WHERE upc = '098765432109' LIMIT 1") == (20, 30))
        check("lottery marked", q("SELECT lottery FROM legacy_lines WHERE dept = 275") == (1,))
        check("promotion named", q("SELECT name FROM legacy_lines WHERE kind = 'promo'") == ("Promotion: BUY 2 SAVE 1",))
        check("item names and brands from the item list",
              q("SELECT name, brand FROM legacy_lines WHERE upc = '012345678905' LIMIT 1") == ("MADE UP CIGAR ROBUSTO", "ACME CIGARS"))
        check("business day of each Z", q("SELECT GROUP_CONCAT(day) FROM (SELECT day FROM legacy_z ORDER BY day)")[0] == "2026-10-27,2026-10-28")
        check("mode 1 receipt kept, not a sale", q("SELECT mode FROM legacy_receipts WHERE receipt_num = 9005") == (1,))
        check("birth date read (2-digit year in the past)", q("SELECT dob FROM legacy_receipts WHERE receipt_num = 9001") == ("1980-01-02",))
        check("cashier-level Z tax rows ignored", q("SELECT cents FROM legacy_z_values v JOIN legacy_z z ON z.id = v.z_id WHERE z.z_counter = 502 AND name = 'ilsa:tax'") == (95,))
        check("day 1 matches ILSA's Z", q("SELECT COUNT(*) FROM legacy_variances WHERE day = '2026-10-27'") == (0,))
        cash = q("SELECT ilsa_cents, ours_cents FROM legacy_variances WHERE day = '2026-10-28' AND what LIKE 'Tender Cash%'")
        check("day 2 cash: ILSA -$23.05 vs imported -$24.05 (cash less all change)", cash == (-2305, -2405))
        check("tax and card match on day 2", q("SELECT COUNT(*) FROM legacy_variances WHERE day = '2026-10-28' AND (what = 'Tax' OR what LIKE 'Tender Credit%')") == (0,))
        check("paid outs match RegReconcile", q("SELECT COUNT(*) FROM legacy_variances WHERE what = 'Paid outs'") == (0,))
        check("Z_Totals Z_PLU_AMT learned as item sales (lottery in)",
              q("SELECT COUNT(*) FROM legacy_variances WHERE what LIKE 'Z_Totals%'") == (0,))
        check("the newest day is kept as partial", q("SELECT partial FROM legacy_days WHERE day = '2026-10-28'") == (1,))
        check("variance list saved", res["csv"] and os.path.exists(res["csv"]))
        before = q("SELECT COUNT(*), SUM(amount_cents) FROM legacy_lines")
        db.close()
        again = run(exp, dbp, None, None, False, False, out, quiet=True, now=now, manage=False)
        db = sqlite3.connect(dbp)
        check("re-run: the complete day is skipped, the partial day replaced, nothing doubled",
              again["days"] == ["2026-10-28"] and db.execute("SELECT COUNT(*), SUM(amount_cents) FROM legacy_lines").fetchone() == before)
        db.close()
        old = os.path.join(tmp, "older made up export"); os.makedirs(old); older_export(old)
        third = run(old, dbp, None, "2026-10-26", False, False, out, quiet=True, now=now, manage=False)
        db = sqlite3.connect(dbp)
        q = lambda s, *a: db.execute(s, a).fetchone()
        check("an older copy's day, up to --to", third["days"] == ["2026-10-20"])
        check("an item gone from its copy's list named from another copy's list",
              q("SELECT name, brand, name_src FROM legacy_lines WHERE upc = '55555555555'") == ("MADE UP CUTTER", "SPARKY", "other"))
        check("an item in no list keeps its department's name, marked",
              q("SELECT name, name_src FROM legacy_lines WHERE upc = '077777777777'") == ("OLD ACCESSORIES NAME", "dept"))
        check("the older copy doesn't rename departments", q("SELECT name FROM legacy_depts WHERE dept = 20") == ("ACCESSORIES",))
        check("every copy's check prefix: BHDAN unless set",
              [r[0] for r in db.execute("SELECT store FROM legacy_sources ORDER BY id")] == ["BHDAN", "BHDAN"])
        check("each copy's cashiers: number and name only",
              db.execute("SELECT source_id, cashier_num, name FROM legacy_cashiers ORDER BY 1, 2").fetchall()
              == [(1, 3, "Test Cashier Three"), (1, 4, "Test Cashier Four"), (2, 2, "Test Cashier Two")]
              and [c[1] for c in db.execute("PRAGMA table_info(legacy_cashiers)")] == ["source_id", "cashier_num", "name"])
        check("the older day matches its Z", q("SELECT COUNT(*) FROM legacy_variances WHERE day = '2026-10-20'") == (0,))
        check("birth dates found in another table by their values (ID_VALUE), tied by receipt",
              q("SELECT dob FROM legacy_receipts WHERE receipt_num = 8001") == ("1976-07-04",)
              and q("SELECT dob FROM legacy_receipts WHERE receipt_num = 8002") == ("",))
        db.execute("UPDATE legacy_receipts SET dob = '' WHERE receipt_num = 8001"); db.commit(); db.close()
        filled = fill_dob_command(old, dbp, None, False, out)
        db = sqlite3.connect(dbp)
        q = lambda s, *a: db.execute(s, a).fetchone()
        check("--fill-dob fills receipts already imported", filled == 1 and q("SELECT dob FROM legacy_receipts WHERE receipt_num = 8001") == ("1976-07-04",))
        check("a receipt discount explains its total (no difference)",
              q("SELECT COUNT(*) FROM legacy_variances WHERE what LIKE 'Receipts%'") == (0,))
        before = db.execute("SELECT * FROM legacy_variances ORDER BY id").fetchall()
        db.close()
        stats = recheck(dbp, None, None, False, out, quiet=True)
        db = sqlite3.connect(dbp)
        q = lambda s, *a: db.execute(s, a).fetchone()
        check("--recheck: every receipt explained, the same differences",
              stats.get("unexplained", 0) == 0 and stats.get("lines + tax - receipt discount") == 1
              and [r[1:] for r in db.execute("SELECT * FROM legacy_variances ORDER BY id")] == [r[1:] for r in before])
        db.execute("UPDATE legacy_receipts SET total_cents = total_cents + 5 WHERE receipt_num = 8001")
        db.commit(); db.close()
        stats = recheck(dbp, None, None, True, out, quiet=True)
        db = sqlite3.connect(dbp)
        check("--recheck finds a receipt that doesn't add up; --dry-run keeps the file",
              stats.get("unexplained") == 1 and db.execute("SELECT COUNT(*) FROM legacy_variances WHERE what LIKE 'Receipts%'").fetchone() == (0,))
        db.execute("UPDATE legacy_receipts SET total_cents = total_cents - 5 WHERE receipt_num = 8001")
        db.commit()
        db.close()
        # Another store's copy: refused under the wrong store, imported under its own, its days its own.
        nm = os.path.join(tmp, "made up other store"); os.makedirs(nm); other_store_export(nm)
        try:
            run(nm, dbp, None, None, False, False, out, quiet=True, now=now, manage=False, prefix="BHDAN")
            refused = False
        except SystemExit:
            refused = True
        db = sqlite3.connect(dbp)
        db.execute("DELETE FROM legacy_sources WHERE name = 'made up other store'"); db.commit(); db.close()
        check("another store's export is refused under the wrong store", refused)
        bhnm = run(nm, dbp, None, None, False, False, out, quiet=True, now=now, manage=False, prefix="BHNM")
        db = sqlite3.connect(dbp)
        q = lambda s, *a: db.execute(s, a).fetchone()
        check("another store's copy imported under its own store",
              bhnm["days"] == ["2026-10-15"] and q("SELECT store FROM legacy_days WHERE day = '2026-10-15'") == ("BHNM",))
        # The same day in two stores: on a copy of the file, a BHNM copy of 2026-10-28 neither skips nor replaces BHDAN's.
        side = os.path.join(tmp, "side.db"); shutil.copyfile(dbp, side)
        nm2 = os.path.join(tmp, "made up other store 2"); os.makedirs(nm2); other_store_export(nm2)
        for t in ("RegZCnt", "RegSale", "PDetail"):
            path = os.path.join(nm2, t + ".csv")
            text = open(path).read().replace("10/15/26", "10/28/26")
            open(path, "w").write(text)
        before28 = sqlite3.connect(side).execute("SELECT COUNT(*) FROM legacy_receipts WHERE day = '2026-10-28'").fetchone()[0]
        res2 = run(nm2, side, None, None, False, False, out, quiet=True, now=now, manage=False, prefix="BHNM")
        sd = sqlite3.connect(side)
        check("the same day in two stores: both kept",
              res2["days"] == ["2026-10-28"]
              and sd.execute("SELECT COUNT(*) FROM legacy_receipts WHERE day = '2026-10-28'").fetchone()[0] == before28 + 1
              and sd.execute("SELECT GROUP_CONCAT(store) FROM (SELECT store FROM legacy_days WHERE day = '2026-10-28' ORDER BY store)").fetchone()[0] == "BHDAN,BHNM")
        sd.close()
        check("readable by ViewTouch read-only (no WAL left)", db.execute("PRAGMA journal_mode").fetchone()[0] == "delete")
        text = fixture_sql(db)
        db.close()
        if write_fixture:
            with open(FIXTURE, "w") as f:
                f.write("// Made-up ILSA history (scripts/bin/vt-ilsa-history --self-test --write-fixture writes it):\n"
                        "// the history file's tables and rows, one statement per line, for tests/test_legacy.cpp.\n"
                        'R"SQL(\n' + text + ')SQL"\n')
            print(f"  wrote {os.path.normpath(FIXTURE)}")
        elif os.path.exists(FIXTURE):
            have = open(FIXTURE).read()
            check("the C++ tests' fixture is this importer's output (else --write-fixture)", text in have)
    print("self-test " + ("passed" if ok else "FAILED"))
    return 0 if ok else 1


def main(argv):
    if "--self-test" in argv:
        return self_test("--write-fixture" in argv)
    args, opts = [], {}
    it = iter(argv)
    for a in it:
        if a in ("--from", "--to", "--db", "--out", "--dob", "--prefix", "--store"):
            opts[a] = next(it, "")
        elif a.startswith("--"):
            opts[a] = True
        else:
            args.append(a)
    if "--help" in opts or "-h" in args:
        print(__doc__); return 0
    for k in ("--from", "--to"):
        if k in opts and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", opts[k]):
            sys.exit(f"{k}: write the date like 2026-10-28")
    if "--prefix" in opts and not args:   # every copy's
        dbp = os.path.expanduser(opts.get("--db", DEFAULT_DB))
        if not os.path.exists(dbp):
            sys.exit(f"No history file at {dbp}: import first.")
        db = open_db(dbp)
        print(f"Check prefix for every ILSA copy: {set_prefix(db, opts['--prefix'])}")
        close_db(db)
        if "--recheck" not in opts:
            return 0
    if "--recheck" in opts:
        recheck(os.path.expanduser(opts.get("--db", DEFAULT_DB)), opts.get("--from"), opts.get("--to"),
                bool(opts.get("--dry-run")), os.path.expanduser(opts.get("--out", OUT_DIR)),
                store=opts.get("--store") if isinstance(opts.get("--store"), str) else None)
        return 0
    export = os.path.expanduser(args[0]) if args else None
    if export and not os.path.isdir(export) and os.path.isdir(os.path.join(EXPORT, args[0])):
        export = os.path.join(EXPORT, args[0])
    if not export or not os.path.isdir(export):
        sys.exit('Usage: vt-ilsa-history ~/ilsa-export/"copy bhdan 10-29-2026" [--dry-run] [--from YYYY-MM-DD] [--to YYYY-MM-DD] [--replace]')
    for k in ("--from", "--to"):
        if k in opts and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", opts[k]):
            sys.exit(f"{k}: write the date like 2026-10-28")
    if "--fill-dob" in opts:
        fill_dob_command(export, os.path.expanduser(opts.get("--db", DEFAULT_DB)), opts.get("--dob"),
                         bool(opts.get("--dry-run")), os.path.expanduser(opts.get("--out", OUT_DIR)))
        return 0
    run(export, os.path.expanduser(opts.get("--db", DEFAULT_DB)), opts.get("--from"), opts.get("--to"),
        bool(opts.get("--dry-run")), bool(opts.get("--replace")), os.path.expanduser(opts.get("--out", OUT_DIR)),
        prefix=opts.get("--prefix") if isinstance(opts.get("--prefix"), str) else None, force=bool(opts.get("--force")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
